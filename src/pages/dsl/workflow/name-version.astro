---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-workflow-name-version.head.html?raw';
import tail from '../../../_mock/dsl-element-workflow-name-version.tail.html?raw';
import js from '../../../_mock/dsl-element-workflow-name-version.js?raw';
---

<BaseLayout title="name and version — Hydra DSL" description="Name a workflow and record the manifest version it targets.">
  <style is:global set:html={css}></style>
  <DslShell current="workflow-name-and-version">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
