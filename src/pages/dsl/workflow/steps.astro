---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-workflow-steps.head.html?raw';
import tail from '../../../_mock/dsl-element-workflow-steps.tail.html?raw';
import js from '../../../_mock/dsl-element-workflow-steps.js?raw';
---

<BaseLayout title="steps — Hydra DSL" description="Declare job and action nodes in a workflow dependency graph.">
  <style is:global set:html={css}></style>
  <DslShell current="workflow-steps">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
