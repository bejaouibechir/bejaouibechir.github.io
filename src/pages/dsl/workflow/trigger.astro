---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-workflow-trigger.head.html?raw';
import tail from '../../../_mock/dsl-element-workflow-trigger.tail.html?raw';
import js from '../../../_mock/dsl-element-workflow-trigger.js?raw';
---

<BaseLayout title="trigger — Hydra DSL" description="Declare whether a workflow starts manually, on a schedule or through a webhook.">
  <style is:global set:html={css}></style>
  <DslShell current="workflow-trigger">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
