---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DslShell from '../../components/DslShell.astro';
import css from '../../_mock/dsl.css?raw';
import head from '../../_mock/dsl-pipeline-yaml.head.html?raw';
import tail from '../../_mock/dsl-pipeline-yaml.tail.html?raw';
import js from '../../_mock/dsl-pipeline-yaml.js?raw';
---

<BaseLayout title="pipeline.yaml — Hydra DSL" description="Select one declared source and one declared destination to give a job its direction.">
  <style is:global set:html={css}></style>
  <DslShell current="manifest-pipeline-yaml">
    <div class="main-inner">
      <Fragment set:html={head} />
      <Fragment set:html={tail} />
    </div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
