---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-destinations-connection.head.html?raw';
import tail from '../../../_mock/dsl-element-destinations-connection.tail.html?raw';
import js from '../../../_mock/dsl-element-destinations-connection.js?raw';
---

<BaseLayout title="connection — Hydra DSL" description="Configure how a destination connector reaches its target system.">
  <style is:global set:html={css}></style>
  <DslShell current="destinations-connection">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
