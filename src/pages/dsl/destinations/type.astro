---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-destinations-type.head.html?raw';
import tail from '../../../_mock/dsl-element-destinations-type.tail.html?raw';
import js from '../../../_mock/dsl-element-destinations-type.js?raw';
---

<BaseLayout title="type — Hydra DSL" description="Choose the connector that writes a destination.">
  <style is:global set:html={css}></style>
  <DslShell current="destinations-type">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
