---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-transformations-columns.head.html?raw';
import tail from '../../../_mock/dsl-element-transformations-columns.tail.html?raw';
import js from '../../../_mock/dsl-element-transformations-columns.js?raw';
---

<BaseLayout title="Columns — Hydra DSL" description="Select, rename and cast columns in a transformation plan.">
  <style is:global set:html={css}></style>
  <DslShell current="transformations-columns">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
