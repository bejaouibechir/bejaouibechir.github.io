---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-transformations-reshape.head.html?raw';
import tail from '../../../_mock/dsl-element-transformations-reshape.tail.html?raw';
import js from '../../../_mock/dsl-element-transformations-reshape.js?raw';
---

<BaseLayout title="Reshape — Hydra DSL" description="Change table layout with pivot, unpivot and transpose.">
  <style is:global set:html={css}></style>
  <DslShell current="transformations-reshape">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
