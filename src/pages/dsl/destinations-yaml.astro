---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DslShell from '../../components/DslShell.astro';
import css from '../../_mock/dsl.css?raw';
import head from '../../_mock/dsl-destinations-yaml.head.html?raw';
import tail from '../../_mock/dsl-destinations-yaml.tail.html?raw';
import js from '../../_mock/dsl-destinations-yaml.js?raw';
---

<BaseLayout title="destinations.yaml — Hydra DSL" description="Declare where final rows land and how each target is written.">
  <style is:global set:html={css}></style>
  <DslShell current="manifest-destinations-yaml">
    <div class="main-inner">
      <Fragment set:html={head} />
      <Fragment set:html={tail} />
    </div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
