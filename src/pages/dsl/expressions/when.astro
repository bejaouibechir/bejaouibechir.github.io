---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-expressions-when.head.html?raw';
import tail from '../../../_mock/dsl-element-expressions-when.tail.html?raw';
import js from '../../../_mock/dsl-element-expressions-when.js?raw';
---

<BaseLayout title="step.when — Hydra DSL" description="Conditionally run a workflow step with a safe boolean expression.">
  <style is:global set:html={css}></style>
  <DslShell current="expressions-step-when">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
