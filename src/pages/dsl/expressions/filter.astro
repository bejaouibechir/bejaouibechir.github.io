---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-expressions-filter.head.html?raw';
import tail from '../../../_mock/dsl-element-expressions-filter.tail.html?raw';
import js from '../../../_mock/dsl-element-expressions-filter.js?raw';
---

<BaseLayout title="filter.expr — Hydra DSL" description="Write boolean row predicates for the filter operation.">
  <style is:global set:html={css}></style>
  <DslShell current="expressions-filter-expr">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
