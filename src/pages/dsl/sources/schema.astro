---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DslShell from '../../../components/DslShell.astro';
import css from '../../../_mock/dsl.css?raw';
import head from '../../../_mock/dsl-element-sources-schema.head.html?raw';
import tail from '../../../_mock/dsl-element-sources-schema.tail.html?raw';
import js from '../../../_mock/dsl-element-sources-schema.js?raw';
---

<BaseLayout title="schema — Hydra DSL" description="Describe expected source fields and schema policies.">
  <style is:global set:html={css}></style>
  <DslShell current="sources-schema">
    <div class="main-inner"><Fragment set:html={head} /><Fragment set:html={tail} /></div>
  </DslShell>
  <script is:inline set:html={js}></script>
</BaseLayout>
