---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoFacade from '../components/VideoFacade.astro';
import { tracks, upcoming } from '../data/academy.js';

const SITE_UTM = '?utm_source=hydraetl&utm_medium=academy&utm_campaign=';
---

<BaseLayout
  title="Hydra Academy — video tracks"
  description="Hydra Academy: short videos that walk through Hydra ETL, each one paired with a Killercoda lab you can run in your browser. Start with the Hydra CLI track."
>
  <main class="ac">
    <section class="ac-hero">
      <div class="ac-wrap">
        <p class="ac-eyebrow">Hydra Academy</p>
        <h1>Watch it, then try it in your browser</h1>
        <p class="ac-lead">
          Short videos on Hydra ETL, grouped by track. Every video follows a free Killercoda lab:
          watch how it works, then run the same commands yourself, with nothing to install.
        </p>
      </div>
    </section>

    {tracks.map((track) => (
      <section class="ac-track" id={track.id}>
        <div class="ac-wrap">
          <div class="ac-track-head">
            <div>
              <h2>{track.title}</h2>
              <p>{track.lead}</p>
            </div>
            <a class="ac-btn" href={track.playlist} target="_blank" rel="noopener" data-umami-event="playlist-click" data-umami-event-track={track.id}>
              Full playlist on YouTube
            </a>
          </div>

          <ol class="ac-list">
            {track.videos.map((v, i) => (
              <li class="ac-item">
                <VideoFacade id={v.youtube} title={v.title} thumb={v.thumb} duration={v.duration} location="academy" />
                <div class="ac-body">
                  <span class="ac-num">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{v.title}</h3>
                  <p>{v.summary}</p>
                  <ul>
                    {v.steps.map((s) => <li set:html={s} />)}
                  </ul>
                  <div class="ac-actions">
                    <a class="ac-btn ac-primary" href={v.lab.url + SITE_UTM + track.id} target="_blank" rel="noopener" data-umami-event="killercoda-click" data-umami-event-location="academy">
                      Try it: {v.lab.label}
                    </a>
                    <a class="ac-link" href={`https://www.youtube.com/watch?v=${v.youtube}&list=${track.playlist.split('list=')[1]}`} target="_blank" rel="noopener">Watch on YouTube</a>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))}

    <section class="ac-next">
      <div class="ac-wrap">
        <p><strong>Next tracks:</strong> {upcoming.join(', ')}.</p>
        <p>Prefer reading? The <a href="/cli/">Hydra CLI tutorials</a> and the <a href="/guide/">guide</a> cover the same ground in text.</p>
      </div>
    </section>
  </main>

  <style>
    .ac-wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); }
    .ac-hero { padding: 56px 0 36px; border-bottom: 1px solid var(--border); }
    .ac-eyebrow { margin: 0 0 8px; color: var(--accent-text); font: 800 12px var(--mono); text-transform: uppercase; letter-spacing: .09em; }
    .ac-hero h1 { margin: 0 0 12px; font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.08; letter-spacing: -.03em; }
    .ac-lead { max-width: 46em; margin: 0; color: var(--text-soft); font-size: 1.05rem; }
    .ac-track { padding: 44px 0 20px; }
    .ac-track-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
    .ac-track-head h2 { margin: 0 0 6px; font-size: clamp(1.4rem, 2.4vw, 1.8rem); }
    .ac-track-head p { margin: 0; max-width: 44em; color: var(--text-soft); }
    .ac-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 34px; }
    .ac-item { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 28px; align-items: start; }
    .ac-num { color: var(--accent-text); font: 800 12px var(--mono); }
    .ac-body h3 { margin: 4px 0 8px; font-size: 1.2rem; line-height: 1.3; }
    .ac-body p { margin: 0 0 10px; color: var(--text-soft); }
    .ac-body ul { margin: 0 0 16px; padding-left: 1.1em; color: var(--text-soft); font-size: .95rem; }
    .ac-body li { margin: 3px 0; }
    .ac-body code { font-size: .88em; }
    .ac-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
    .ac-btn, .ac-link { text-decoration: none; }
    .ac-btn { color: var(--text); display: inline-flex; align-items: center; padding: 9px 14px; border: 1px solid var(--border-strong); border-radius: 9px; font-weight: 650; font-size: .92rem; white-space: nowrap; }
    .ac-btn:hover { border-color: var(--accent); }
    .ac-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .ac-primary:hover { filter: brightness(1.06); }
    .ac-link { color: var(--accent-text); font-size: .92rem; font-weight: 600; }
    .ac-link:hover { text-decoration: underline; }
    .ac-next { padding: 28px 0 64px; color: var(--text-soft); }
    .ac-next p { margin: 6px 0; }
    .ac-next a { color: var(--accent-text); font-weight: 600; }
    @media (max-width: 820px) {
      .ac-track-head { display: block; }
      .ac-track-head .ac-btn { margin-top: 14px; }
      .ac-item { grid-template-columns: 1fr; gap: 16px; }
      .ac-btn { white-space: normal; }
    }
  </style>
</BaseLayout>
