---
import BaseLayout from '../../layouts/BaseLayout.astro';

/* Index du blog : lit les articles Markdown du dossier et les trie du plus
   recent au plus ancien. Ajouter un .md suffit, rien a declarer ici. */
const posts = Object.values(
  import.meta.glob('./*.md', { eager: true })
).sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---

<BaseLayout title="Blog" description="Tutorials and engineering notes about Hydra ETL: declarative YAML pipelines, validation, performance.">
  <style is:global>
    .blog-wrap { max-width: 46rem; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
    .blog-wrap h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); margin: 0 0 .5rem; }
    .blog-lead { color: var(--text-soft); margin: 0 0 2.5rem; }
    .blog-item { border-top: 1px solid var(--border); padding: 1.5rem 0; }
    .blog-item h2 { font-size: 1.25rem; margin: 0 0 .4rem; }
    .blog-item h2 a { color: var(--text); text-decoration: none; }
    .blog-item h2 a:hover { color: var(--accent-text); }
    .blog-item p { margin: 0 0 .4rem; color: var(--text-soft); line-height: 1.6; }
    .blog-date { color: var(--text-mut); font-size: .88rem; }
  </style>

  <main class="blog-wrap">
    <h1>Blog</h1>
    <p class="blog-lead">Tutorials and engineering notes. Every command shown here was run before publishing.</p>
    {posts.map((post) => (
      <article class="blog-item">
        <h2><a href={post.url}>{post.frontmatter.title}</a></h2>
        <p>{post.frontmatter.description}</p>
        <p class="blog-date">
          {new Date(post.frontmatter.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.frontmatter.readingTime ? ` · ${post.frontmatter.readingTime}` : ''}
        </p>
      </article>
    ))}
  </main>
</BaseLayout>
