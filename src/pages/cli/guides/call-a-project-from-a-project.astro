---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CliReferenceShell from '../../../components/CliReferenceShell.astro';
import css from '../../../_mock/learning-hub.css?raw';
import lessonCss from '../../../_mock/cli-lesson.css?raw';
import js from '../../../_mock/learning-hub.js?raw';
import main from '../../../_mock/studio-lesson-40-call-a-project-from-a-project.main.html?raw';
import { lessonJsonLd } from '../../../data/lesson-jsonld.js';
const article = { headline: "Call a Hydra project from another project", description: "Run a Hydra project from another project with a workflow step of type project, and read the two errors you will meet. Tested with 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/cli/guides/call-a-project-from-a-project/',
  name: article.headline,
  steps: ["Create two projects", "Run the child alone", "Add a project step to the master", "Run the master", "Read the two errors"],
  faq: [["How does a Hydra project call another project?", "With a workflow step of type project. The step has a name and a project path, for example project: ../child. The path is read from the root of the calling project. Both projects are ordinary Hydra projects, each with its own .hydra folder."], ["What does the calling project print?", "The step is reported like any other, and the steps of the called project appear under it. In our test: Step 'call_child' OK, then the called workflow and its job."], ["Can a project call itself?", "No. With project: . the run stops before it starts with the message the project calls itself. The same check applies to a loop through several projects, according to the source; we tested only the direct case."], ["What happens if the project folder does not exist?", "The run stops with project folder not found, followed by the path as given and the folder it resolved to. The dry run reports the same error."], ["Does a dry run run the called project?", "In our test the dry run printed Dry run OK for the calling project and did not list the steps of the called project."]],
  crumbs: [['Get started', '/get-started'], ['Hydra CLI', '/cli/'], ['Guides', '/cli/guides/'], ["Sub-projects", '/cli/guides/call-a-project-from-a-project/']],
});
---

<BaseLayout title="Call a Hydra project from another project" exactTitle="Hydra Sub-projects: Call a Project in a Project | Hydra ETL" description="Run a Hydra project from another project with a workflow step of type project, and read the two errors you will meet. Tested with 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <CliReferenceShell current="" guide="call-a-project-from-a-project">
    <article class="cli-article cli-guide">
      <Fragment set:html={main} />
    </article>
  </CliReferenceShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

