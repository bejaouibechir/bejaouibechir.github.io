---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CliReferenceShell from '../../../components/CliReferenceShell.astro';
import css from '../../../_mock/learning-hub.css?raw';
import lessonCss from '../../../_mock/cli-lesson.css?raw';
import js from '../../../_mock/learning-hub.js?raw';
import main from '../../../_mock/studio-lesson-57-run-triggers-with-hdrctl-watch.main.html?raw';
import { lessonJsonLd } from '../../../data/lesson-jsonld.js';
const article = { headline: "Start a Hydra project with interval, marker, file and source triggers", description: "Run interval, marker, file and source_change triggers with hdrctl watch, make each one fire, and read the history. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/cli/guides/run-triggers-with-hdrctl-watch/',
  name: article.headline,
  steps: ["Declare four triggers", "Start hdrctl watch", "Fire the marker", "Fire the file trigger", "Change the source", "Read the interval and the history"],
  faq: [["What runs the triggers of a Hydra project?", "hdrctl watch runs the triggers of one or more projects until you stop it with Ctrl+C. According to its help, hdrctl serve runs them too. We tested hdrctl watch only."], ["What is the difference between a marker and a file trigger?", "A marker trigger watches one file and, by default, removes it after the run: go.flag was gone when the run ended in our test. A file trigger watches a pattern such as Data/incoming/*.csv and starts a run for each new file."], ["Why did my file trigger never fire?", "The path is a pattern for files. In our first test we wrote path: Data/incoming, which names a folder, and nothing happened. With Data/incoming/*.csv the run started a few seconds after the file appeared."], ["Do the files that already exist start a run?", "According to the source, files present when watch starts are the starting state and start nothing. We did not test this."], ["How does a source_change trigger work?", "It reads the source of a job at an interval and compares a value: count, max of a column or checksum. watch printed a reference value at the start, then the old and new value when we added a row to the CSV. The check ran every 60 seconds in our test."]],
  crumbs: [['Get started', '/get-started'], ['Hydra CLI', '/cli/'], ['Guides', '/cli/guides/'], ["Other triggers", '/cli/guides/run-triggers-with-hdrctl-watch/']],
});
---

<BaseLayout title="Interval, marker, file and source triggers with hdrctl watch" exactTitle="Hydra hdrctl watch: File and Interval Triggers | Hydra ETL" description="Run interval, marker, file and source_change triggers with hdrctl watch, make each one fire, and read the history. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <CliReferenceShell current="watch" guide="run-triggers-with-hdrctl-watch">
    <article class="cli-article cli-guide">
      <Fragment set:html={main} />
    </article>
  </CliReferenceShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

