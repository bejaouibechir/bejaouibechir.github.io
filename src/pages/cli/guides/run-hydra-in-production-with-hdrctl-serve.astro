---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CliReferenceShell from '../../../components/CliReferenceShell.astro';
import css from '../../../_mock/learning-hub.css?raw';
import lessonCss from '../../../_mock/cli-lesson.css?raw';
import js from '../../../_mock/learning-hub.js?raw';
import main from '../../../_mock/studio-lesson-65-run-hydra-in-production-with-hdrctl-serve.main.html?raw';
import { lessonJsonLd } from '../../../data/lesson-jsonld.js';
const article = { headline: "Run Hydra ETL in production with hdrctl serve", description: "Start hdrctl serve without Studio, schedule a workflow with a cron trigger and read the scheduled runs from the API. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/cli/guides/run-hydra-in-production-with-hdrctl-serve/',
  name: article.headline,
  steps: ["Put a cron in the workflow", "Start the server without Studio", "Register the project", "Check the server", "Read the scheduled runs"],
  faq: [["How do I run Hydra ETL workflows on a schedule without opening Studio?", "Put a trigger of type schedule with a cron expression in the workflow file, start hdrctl serve with --no-studio, and register the project once. In our test on Hydra ETL 0.22, a workflow with the cron * * * * * ran at the start of three consecutive minutes and each run ended in success."], ["What does --no-studio change?", "The server starts the API only. The home page answers with a short notice that Studio is disabled, and /api/health reports studio as disabled. The scheduler and the API worked the same in our test."], ["Where do I see the scheduled runs?", "At GET /api/runs. Each run has a run_id, the workflow name, a status, the start time in UTC and the field trigger, set to schedule for a scheduled run. Per the source, you can add ?workflow_name=NAME to filter; we did not test the filter."], ["Do the runs survive a restart of the server?", "No, according to our earlier tests: the runs are kept in memory, so the list is empty after a restart. The output files written by the jobs stay on disk."], ["Is the server safe to expose to the internet?", "We did not test any protection. The server listens on 127.0.0.1 by default. Put a proxy that you control in front of it before you change --host."], ["Does the schedule restart on its own after a reboot?", "We did not test it. Plan a service or a task that starts hdrctl serve at boot, and check the runs after the first expected time."]],
  crumbs: [['Get started', '/get-started'], ['Hydra CLI', '/cli/'], ['Guides', '/cli/guides/'], ["Production", '/cli/guides/run-hydra-in-production-with-hdrctl-serve/']],
});
---

<BaseLayout title="Run Hydra ETL in production with hdrctl serve" exactTitle="Hydra ETL in Production: hdrctl serve and Cron | Hydra ETL" description="Start hdrctl serve without Studio, schedule a workflow with a cron trigger and read the scheduled runs from the API. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <CliReferenceShell current="serve" guide="run-hydra-in-production-with-hdrctl-serve">
    <article class="cli-article cli-guide">
      <Fragment set:html={main} />
    </article>
  </CliReferenceShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

