---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CliReferenceShell from '../../../components/CliReferenceShell.astro';
import css from '../../../_mock/learning-hub.css?raw';
import lessonCss from '../../../_mock/cli-lesson.css?raw';
import js from '../../../_mock/learning-hub.js?raw';
import main from '../../../_mock/studio-lesson-21-configure-snowflake-bigquery-and-cdc-sources.main.html?raw';
import { lessonJsonLd } from '../../../data/lesson-jsonld.js';
const article = { headline: "Advanced sources: Snowflake, BigQuery and CDC", description: "Write Snowflake, BigQuery and CDC sources, validate them with no server, and read what a run says when the account, driver or server is missing.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/cli/guides/configure-snowflake-bigquery-and-cdc-sources/',
  name: article.headline,
  steps: ["Write the Snowflake source", "Run it against nothing", "Swap in BigQuery", "Swap in a CDC source"],
  faq: [["How do I check a Snowflake, BigQuery or CDC source without a server?", "Run hdrctl validate on the job folder. In our test on Hydra ETL 0.22, validate accepted a Snowflake, a BigQuery, a PostgreSQL CDC and a MySQL CDC source with made-up values and no server. It checks the shape of the YAML only, not the connection."], ["What does a run say when the server or the account is missing?", "It stops with a message that names the connector and the source. A PostgreSQL CDC run on a closed port answered Connection refused after 3.6 seconds, a BigQuery run without the driver answered that the driver is not installed after 1.6 seconds, and a Snowflake run with a made-up account failed after 13 seconds."], ["Is the password shown in the error?", "Not in our test. The PostgreSQL CDC and MySQL CDC messages print the connection address with the password replaced by three stars, and the Snowflake message prints the user without the password."], ["What do the CDC sources need on the database side?", "According to the connector documentation in the source, PostgreSQL needs a role with the REPLICATION attribute, and MySQL needs the binary log on in ROW format with full row images. We did not test either, because it needs a database server."], ["Does Hydra ETL read MongoDB with this configuration?", "We did not cover it. In our test, validate accepted a MongoDB source with extract.table, but a run asked for a collection name, and with extract.collection alone the engine asked for a table or a query. Check the current documentation before you rely on it."]],
  crumbs: [['Get started', '/get-started'], ['Hydra CLI', '/cli/'], ['Guides', '/cli/guides/'], ["Advanced sources", '/cli/guides/configure-snowflake-bigquery-and-cdc-sources/']],
});
---

<BaseLayout title="Advanced sources: Snowflake, BigQuery and CDC" exactTitle="Hydra Advanced Sources: Snowflake, BigQuery, CDC | Hydra ETL" description="Write Snowflake, BigQuery and CDC sources, validate them with no server, and read what a run says when the account, driver or server is missing." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <CliReferenceShell current="" guide="configure-snowflake-bigquery-and-cdc-sources">
    <article class="cli-article cli-guide">
      <Fragment set:html={main} />
    </article>
  </CliReferenceShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

