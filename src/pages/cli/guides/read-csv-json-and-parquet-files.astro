---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CliReferenceShell from '../../../components/CliReferenceShell.astro';
import css from '../../../_mock/learning-hub.css?raw';
import lessonCss from '../../../_mock/cli-lesson.css?raw';
import js from '../../../_mock/learning-hub.js?raw';
import main from '../../../_mock/studio-lesson-19-read-csv-json-and-parquet-files.main.html?raw';
import { lessonJsonLd } from '../../../data/lesson-jsonld.js';
const article = { headline: "Read CSV, JSON and Parquet files in a Hydra job", description: "Declare CSV, JSON and Parquet file sources in a Hydra job, run them, and read the error of a missing file. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/cli/guides/read-csv-json-and-parquet-files/',
  name: article.headline,
  steps: ["Prepare one file per format", "Declare the three sources", "Validate and run each job", "Read the error of a missing file"],
  faq: [["How do I read a CSV, JSON or Parquet file in Hydra ETL?", "Declare a source in sources.yaml with type csv, json or parquet, and put the file path in extract.table. Nothing else changes between the three. In our test each job read 3 rows and wrote 3."], ["Is the path relative to something?", "In our test, a path such as data/people.csv was read from the job folder, so the files sat in jobs//data."], ["What shape must a JSON file have?", "We tested a file that holds a list of objects, one object per row, with the same keys in each. Other shapes were not tested."], ["Does Parquet need an extra package?", "According to pyproject.toml, Parquet support comes with the optional parquet extra, which installs pyarrow. Install it with pip install \"hydra-etl[parquet]\" if Hydra ETL complains. We created our Parquet file with pandas."], ["Can I read a CSV that uses semicolons?", "Not in our test on Hydra ETL 0.22. We set delimiter under connection and next to extract, and each time the file loaded as one column named id;name;value. Until this changes, convert the file to commas, or check the release notes of your version."]],
  crumbs: [['Get started', '/get-started'], ['Hydra CLI', '/cli/'], ['Guides', '/cli/guides/'], ["File sources", '/cli/guides/read-csv-json-and-parquet-files/']],
});
---

<BaseLayout title="Read CSV, JSON and Parquet files in a Hydra job" exactTitle="Hydra File Sources: Read CSV, JSON, Parquet | Hydra ETL" description="Declare CSV, JSON and Parquet file sources in a Hydra job, run them, and read the error of a missing file. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <CliReferenceShell current="" guide="read-csv-json-and-parquet-files">
    <article class="cli-article cli-guide">
      <Fragment set:html={main} />
    </article>
  </CliReferenceShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

