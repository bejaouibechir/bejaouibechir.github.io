---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CliReferenceShell from '../../../components/CliReferenceShell.astro';
import css from '../../../_mock/learning-hub.css?raw';
import lessonCss from '../../../_mock/cli-lesson.css?raw';
import js from '../../../_mock/learning-hub.js?raw';
import main from '../../../_mock/studio-lesson-39-manage-jobs-and-parameters-from-the-cli.main.html?raw';
import { lessonJsonLd } from '../../../data/lesson-jsonld.js';
const article = { headline: "Manage the jobs and parameters of a Hydra project", description: "Add, attach and detach jobs in a workflow, and set project parameters per environment with hdrctl job and hdrctl param. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/cli/guides/manage-jobs-and-parameters-from-the-cli/',
  name: article.headline,
  steps: ["List the jobs", "Add a job to a workflow", "Detach and attach at a position", "Declare a parameter", "Use the parameter in a job", "Give the parameter a value per environment"],
  faq: [["How do I add a job to a workflow from the command line?", "Run hdrctl job add . It creates jobs// from a template and adds a step of type job at the end of the workflow, after the previous step. Add -p N to choose the position."], ["What does detaching a job do?", "hdrctl job detach removes the step and keeps the job folder in jobs/. The steps that ran after it now run after its own predecessors. hdrctl job list then shows the job as free."], ["Where is a project parameter stored?", "Its type, default value and description are in parameters.yaml at the project root. The value for an environment is in environments/.yaml. Both are written by hdrctl param set."], ["How do I use a parameter in a job?", "Write {{ param:NAME }} where the value goes, for example in a filter expression. In our test a job with value > {{ param:min_value }} wrote 2 rows with the default 0, and 1 row with the value 150 of the prod environment."], ["How do I run a job with an environment?", "Add --env NAME to hdrctl run. We ran hdrctl run jobs\\job1 --env prod, and the job used the prod value of the parameter."]],
  crumbs: [['Get started', '/get-started'], ['Hydra CLI', '/cli/'], ['Guides', '/cli/guides/'], ["Manage projects", '/cli/guides/manage-jobs-and-parameters-from-the-cli/']],
});
---

<BaseLayout title="Manage the jobs and parameters of a Hydra project" exactTitle="Hydra Jobs and Parameters: hdrctl job, param | Hydra ETL" description="Add, attach and detach jobs in a workflow, and set project parameters per environment with hdrctl job and hdrctl param. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <CliReferenceShell current="job" guide="manage-jobs-and-parameters-from-the-cli">
    <article class="cli-article cli-guide">
      <Fragment set:html={main} />
    </article>
  </CliReferenceShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

