---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductLearningShell from '../components/ProductLearningShell.astro';
import { studioLessons } from '../data/studio-lessons.js';
import css from '../_mock/learning-hub.css?raw';
import js from '../_mock/learning-hub.js?raw';
---

<BaseLayout title="Hydra Studio tutorials" description="A structured learning track for designing, validating and running Hydra jobs visually in Studio.">
  <style is:global set:html={css}></style>
  <ProductLearningShell product="Studio" title="Hydra Studio tutorials" lead="Learn Hydra ETL Studio from first launch to orchestration and resilience: jobs, sources, transformations, actions, workflows, fallbacks, triggers and AI assistance. Lessons marked Coming soon are being written." duration="about 90 minutes for the lessons available today" lessons={studioLessons} referenceHref="/playground" referenceLabel="Explore a job without installing" />
  <script is:inline set:html={js}></script>
</BaseLayout>

