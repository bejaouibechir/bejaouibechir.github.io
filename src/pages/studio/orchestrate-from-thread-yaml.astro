---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-59-orchestrate-from-thread-yaml.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Orchestrate a Hydra project from thread.yaml", description: "Every key of workflows/thread.yaml in Hydra ETL, validated with hdrctl run --dry-run, plus the four error messages you will meet. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/orchestrate-from-thread-yaml/',
  name: article.headline,
  steps: ["Read the keys", "Validate with a dry run", "Read the error messages", "Edit it in Studio instead"],
  faq: [["What is thread.yaml in a Hydra project?", "thread.yaml is the file workflows/thread.yaml. It lists the workflows of a project in stages, each sequential or parallel, with optional waits, timeouts, fallbacks and loops. hdrctl run reads it, and so does the Execution order tab of Studio."], ["How do I validate thread.yaml?", "Run hdrctl run . --dry-run in the project folder. It validates the thread and every workflow it names, prints the execution plan, and runs nothing. hdrctl workflow validate does not accept thread.yaml: it expects a workflow file."], ["What formats do delays and timeouts accept?", "A number of seconds, or a duration written as 500ms, 30s, 5m or 1h. In our test 1s, 2s and 30s were accepted and 5x was rejected with a message listing the valid formats."], ["Which keys does a stage accept?", "A stage accepts mode, delay_after and workflows. A workflow accepts name, active, delay_before, timeout and fallback. Any other key is rejected: our typo modee was reported as an extra input that is not permitted."], ["What happens if workflows/thread.yaml does not exist?", "Studio says that no thread.yaml exists yet and that the workflows run in alphabetical order until you save. This lesson did not test that case from the command line."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["thread.yaml", '/studio/orchestrate-from-thread-yaml/']],
});
---

<BaseLayout title="Orchestrate a Hydra project from thread.yaml" exactTitle="Hydra thread.yaml: Keys, Dry Run and Errors | Hydra ETL" description="Every key of workflows/thread.yaml in Hydra ETL, validated with hdrctl run --dry-run, plus the four error messages you will meet. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="orchestrate-from-thread-yaml"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

