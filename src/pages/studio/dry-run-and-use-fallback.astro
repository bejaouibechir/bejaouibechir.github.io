---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-49-dry-run-and-use-fallback.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Rehearse fallbacks in Hydra ETL: --dry-run and --use-fallback", description: "Check a Hydra ETL fallback with hdrctl run --dry-run, then force it with --use-fallback without moving a file. Tested on Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/dry-run-and-use-fallback/',
  name: article.headline,
  steps: ["Print the plan with --dry-run", "Check the project in Studio", "Force a fallback with --use-fallback", "Read the chain reaction", "Recognize the refusals"],
  faq: [["What does hdrctl run --dry-run do with fallbacks?", "It prints the execution plan with a fallback line under each workflow that has one, validates the project and writes nothing."], ["How do I force a fallback in Hydra ETL?", "Run hdrctl run . --use-fallback followed by the name of the workflow that declares it, for example wf_load."], ["Can I use --use-fallback on a single job?", "No. Hydra ETL refuses it: the option applies to a project, hdrctl run followed by a project folder."], ["Why did a second fallback run after I forced the first?", "Conditions are tested in order. After wf_load_backup loaded 8 rows, previous.rows < 10 was true for wf_report, so its own fallback ran too."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Dry run and --use-fallback", '/studio/dry-run-and-use-fallback/']],
});
---

<BaseLayout title="Rehearse fallbacks in Hydra ETL: --dry-run and --use-fallback" exactTitle="hdrctl dry-run and --use-fallback | Hydra ETL" description="Check a Hydra ETL fallback with hdrctl run --dry-run, then force it with --use-fallback without moving a file. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="dry-run-and-use-fallback"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

