---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-61-break-it-then-recover.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Break a Hydra ETL pipeline on purpose, then recover", description: "Delete an input, make a service fail, break a late step and hang a workflow, then read how each Hydra ETL protection reacts. Tested on Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/break-it-then-recover/',
  name: article.headline,
  steps: ["Delete the input file", "Make the service fail beyond its retries", "Break the last step of the report", "Make a workflow exceed its timeout", "Put the project back"],
  faq: [["How do I test a Hydra ETL fallback?", "Make its condition true on purpose, for example by renaming the input file, run the project and look for the line starting with a fallback arrow. A dry run alone does not test it."], ["What happens when a retried step still fails?", "The workflow fails, and the project stops. In our test wf_archive, which follows wf_flaky, did not run, and the project ended as failed."], ["Why did the report fallback run after I deleted the input?", "The backup of wf_load loads 8 rows, and the condition of wf_report is previous.rows < 10. The two fallbacks chain."], ["Is the failed report published?", "No. In our test the share was deleted and the report restored before the quarantine workflow ran, so nothing was left published."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Break it, then recover", '/studio/break-it-then-recover/']],
});
---

<BaseLayout title="Break a Hydra ETL pipeline on purpose, then recover" exactTitle="Break It, Then Recover: Hydra ETL Failures | Hydra ETL" description="Delete an input, make a service fail, break a late step and hang a workflow, then read how each Hydra ETL protection reacts. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="break-it-then-recover"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

