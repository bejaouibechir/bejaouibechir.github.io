---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-01-install-and-start.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Install Hydra ETL and start Hydra Studio with hdrctl serve", description: "Install Hydra ETL with its server extra, run hdrctl serve and open Hydra Studio at http://127.0.0.1:5678. Commands tested on Windows, Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/install-and-start/',
  name: article.headline,
  steps: ["Check Python", "Create a virtual environment", "Install Hydra ETL with the server extra", "Check the installation", "Start Studio", "Open Studio and check the API"],
  faq: [["How do I install Hydra ETL and start Studio?", "Create a virtual environment, install the package with its server extra using pip install \"hydra-etl[server]\", then run hdrctl serve. Studio opens at http://127.0.0.1:5678. On Windows, use py -m venv to create the environment."], ["Which Python version does Hydra ETL need?", "Python 3.9 or newer, according to the package metadata. In our test of Hydra ETL 0.22.0 we used Python 3.13.7 on Windows."], ["Why install the server extra?", "The base package gives you the engine and the hdrctl command line. The server extra adds the API and the web interface that hdrctl serve starts, so Studio needs it."], ["How do I start Studio on another port?", "Add --port to the command, for example hdrctl serve --port 5679. Other options are --host, --open to open the browser, --no-studio for the API alone, --workspace for the projects folder and --lang for the interface language."], ["Where does Studio keep my projects?", "In the workspace folder, ~/hydra-workspace by default. Pass --workspace to choose another folder. A new workspace gets a sample project named hydra-demo."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Install and start", '/studio/install-and-start/']],
});
---

<BaseLayout title="Install Hydra ETL and start Hydra Studio" exactTitle="Install Hydra ETL and Start Studio | Hydra ETL" description="Install Hydra ETL with its server extra, run hdrctl serve and open Hydra Studio at http://127.0.0.1:5678. Commands tested on Windows, Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="install-and-start"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

