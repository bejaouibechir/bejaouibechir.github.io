---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-29-switch-environments-with-hdrctl-env.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Switch environments in Hydra ETL with hdrctl env", description: "Create dev and prod environments with hdrctl env, read variables with ENV placeholders and pick one with --env. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/switch-environments-with-hdrctl-env/',
  name: article.headline,
  steps: ["Set common variables", "Create the prod environment", "List and show", "Read a variable in a workflow", "Try a name that does not exist", "Unset, rename, delete", "Open the Environments card", "Create the prod environment", "Set a variable and save", "Choose the active environment"],
  faq: [["What is an environment in Hydra ETL?", "A named set of values, such as dev or prod, that a run picks with --env. In our test on Hydra ETL 0.22, an environment held global variables (one file per environment in the Hydra home folder) and, inside the project, a file of parameter values."], ["How do I read an environment variable in a job or workflow?", "Write ${ENV:NAME}. In our test, a log step with ${ENV:API_URL} printed the dev URL in a normal run and the prod URL with --env prod. A name that is defined in no file fails the step: Missing environment variable."], ["What happens if I give --env a name that does not exist?", "Nothing fails. In our test --env staging ran with the common values, with no warning. Check the name with hdrctl env list."], ["Does an environment replace the common variables?", "It adds to them and wins on a clash. In our test prod defined API_URL only, and REGION still came from the common file."], ["How do I try environments without touching my own settings?", "Set HYDRA_HOME to an empty folder before you run the commands. The global files go there instead of the .hydra folder of your user. All the tests of this lesson used it."], ["Can I manage environments in Hydra Studio?", "Yes. The Environments card of Global settings creates, renames and deletes environments and edits their variables. In our test it wrote env.prod in the settings folder, and the project page has a list to choose the active environment."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Environments", '/studio/switch-environments-with-hdrctl-env/']],
});
---

<BaseLayout title="Switch environments in Hydra ETL with hdrctl env" exactTitle="Hydra Environments: hdrctl env Command | Hydra ETL" description="Create dev and prod environments with hdrctl env, read variables with ENV placeholders and pick one with --env. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="switch-environments-with-hdrctl-env"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

