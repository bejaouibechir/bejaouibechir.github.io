---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-04-tour-the-pages.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Tour the Hydra Studio pages: Overview, Runs, Templates, Insights and Settings", description: "Tour the six pages of Hydra Studio: Overview, Runs, Templates, Insights, Settings and Help. Learn what each one is for. Tested on Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/tour-the-pages/',
  name: article.headline,
  steps: ["Start from the Overview", "Read the Runs page", "Browse the templates", "Check the Insights counters", "Open Settings", "Notice Help, and shrink the sidebar"],
  faq: [["What pages does Hydra Studio have?", "Hydra ETL 0.22 has six entries in the sidebar: Overview, Runs, Templates and Insights at the top, then Settings and Help at the bottom. Jobs and workflows have no page of their own: you open them from a project on the Overview."], ["Where are my jobs if there is no Jobs page?", "Inside a project. Open the project from the Overview, open a workflow, and use Jobs configuration to edit a job and Workflow configuration to orchestrate jobs."], ["Why is the Runs page empty?", "Runs lists the runs the server has recorded. On a fresh Studio it shows No runs, with the filter tabs All, Running, Success, Failed and Pending, and fills in as soon as a workflow is executed."], ["Why does Insights show only zeros?", "Insights counts the same runs as the Runs page. With no run recorded, Total runs, Successful, Failed and Running read 0 and the average duration shows a dash."], ["Is the Help page available?", "Not yet. In Hydra ETL 0.22 the page holds a single card saying that help is coming in a future sprint. Use the Documentation link on the Overview instead."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Tour the pages", '/studio/tour-the-pages/']],
});
---

<BaseLayout title="Tour the Hydra Studio pages" exactTitle="Hydra Studio Pages: Overview, Runs, Templates | Hydra ETL" description="Tour the six pages of Hydra Studio: Overview, Runs, Templates, Insights, Settings and Help. Learn what each one is for. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="tour-the-pages"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

