---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-44-declare-undo-actions.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Declare the undo of an action in Hydra ETL Studio", description: "Tell Hydra ETL how to reverse a python, bash or other action, or that there is nothing to reverse, and read the validation error. Tested on Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/declare-undo-actions/',
  name: article.headline,
  steps: ["Read the refusal", "Open the action dialog", "Choose its undo", "Read the undo in the workflow file", "Validate again"],
  faq: [["Why does Hydra ETL refuse my workflow with rollback on?", "Because an action acts outside Hydra ETL. The message names the step and says to add undo with the action that reverses it, or undo: none when there is nothing to reverse."], ["When should I use undo: none?", "When the action has no effect to reverse, for example a notification that only prints a line. If it does change something, write the action that reverses it."], ["Which actions can serve as an undo?", "The Studio list offers bash, powershell, python, webhook, ssh, email and log."], ["What does hdrctl workflow undo do?", "It finishes an interrupted rollback. When nothing is pending, it answers that there is nothing to undo; it does not undo a workflow that completed."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Declare the undo of an action", '/studio/declare-undo-actions/']],
});
---

<BaseLayout title="Declare the undo of an action in Hydra ETL Studio" exactTitle="Declare the Undo of an Action in Hydra ETL | Hydra ETL" description="Tell Hydra ETL how to reverse a python, bash or other action, or that there is nothing to reverse, and read the validation error. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="declare-undo-actions"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

