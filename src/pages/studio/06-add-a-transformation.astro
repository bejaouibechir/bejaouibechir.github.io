---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-06-add-a-transformation.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Add a transformation in Hydra Studio: the 20 operations", description: "Add and chain the 20 Hydra Studio transformations on the studio-course job, and see why their order matters. Hydra ETL 0.22.", datePublished: '2026-11-04', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/06-add-a-transformation/',
  name: article.headline,
  steps: ["Read the twenty operations", "Open the Select and Filter nodes", "Chain them: the order is the meaning", "Add one, and connect it", "Bring a second flow in"],
  faq: [
    ["How many transformations does Hydra Studio have?", "Twenty in Hydra ETL 0.22, from Filter to Script. Script closes the list and holds your own Python for what the other nineteen do not cover."],
    ["Does the order of transformations matter?", "Yes. The engine runs them top to bottom. In our test on the course job, a Select that dropped the status column before a Filter on status made the run fail with: name 'status' is not defined."],
    ["Which transformations combine two streams?", "Join, Merge and Union. According to the Studio node catalog, Join combines two flows on a key or as a cross product, Merge upserts a source into a target, and Union appends a source."],
    ["Why does Studio refuse an edge between two nodes?", "Studio checks every connection and shows a Connection rejected warning with the reason: the edge already exists, it would create a cycle, a node cannot have an input or an output, or a node has reached its maximum number of inputs or outputs."],
  ],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Transformations", '/studio/06-add-a-transformation/']],
});
---

<BaseLayout title="Add a transformation in Hydra Studio: the 20 operations" exactTitle="Hydra Studio Transformations: Add and Chain Them | Hydra ETL" description="Add and chain the 20 Hydra Studio transformations on the studio-course job, and see why their order matters. Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="06-add-a-transformation"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

