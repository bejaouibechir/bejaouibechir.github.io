---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-50-branch-with-the-condition-node.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Branch a Hydra Studio workflow with the Condition node", description: "Branch a Hydra ETL workflow with the Condition node: set a variable, guard steps with when, and see one path run and the other skipped. Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/branch-with-the-condition-node/',
  name: article.headline,
  steps: ["Open the Condition dialog", "Write a workflow with two branches", "Validate the workflow", "Run it and read the two branches"],
  faq: [["What does the Condition node do in Hydra Studio?", "It evaluates a condition and stores the true or false result in a variable. Steps that come after it read that variable in their run condition, written when in YAML, so a step runs only on the matching branch."], ["How do I make a step run only when a condition is true?", "Give the Condition node a result variable name, such as big, then set the Run condition (when) of the downstream step to {{ param:big }}. For the opposite branch, use not {{ param:big }}."], ["What is the difference between Expression and Structured mode?", "Structured mode compares a left value and a right value with an operator such as ==, !=, or >=, or contains. Expression mode takes a free boolean expression with comparisons, and, or and not, evaluated without running any code."], ["What happens to the step on the other branch?", "It is skipped. In our test the run reported Step 'small_batch' skipped, and the workflow still completed with all steps OK."], ["Where does the value being compared come from?", "From a project parameter, an environment variable or a runtime parameter, written as {{ param:name }}. In our test a set_param step created count with the value 15 before the condition ran."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Condition", '/studio/branch-with-the-condition-node/']],
});
---

<BaseLayout title="Branch with the Hydra Studio Condition node" exactTitle="Hydra Studio Condition Node: Branch a Workflow | Hydra ETL" description="Branch a Hydra ETL workflow with the Condition node: set a variable, guard steps with when, and see one path run and the other skipped. Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="branch-with-the-condition-node"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

