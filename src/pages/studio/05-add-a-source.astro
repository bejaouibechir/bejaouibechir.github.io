---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-05-add-a-source.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Create a job in Hydra Studio and add its source", description: "Create a job in Hydra Studio, rename it, drop a CSV source and configure it, then read the database and Web API sources. Hydra ETL 0.22.", datePublished: '2026-11-04', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/05-add-a-source/',
  name: article.headline,
  steps: ["Create a job", "Rename it, and know Archive from Delete", "Find the job in the workflow palette", "Drop a source, and read its warning", "Configure the CSV source", "Read a database source", "Read an HTTP source"],
  faq: [
    ["What is a Hydra job made of?", "A job is a folder holding four manifests: sources.yaml, transformations.yaml, destinations.yaml and pipeline.yaml. Studio writes them from the canvas when you save, and hdrctl runs the same files whether you wrote them by hand or designed them."],
    ["How do I create a job in Hydra Studio?", "Open Jobs configuration and press the plus button in the tab bar at the bottom left. Studio adds a job named job1 and opens an empty canvas; double-click its tab, or use Rename in its options menu, to give it your name."],
    ["What is the difference between Archive and Delete for a job?", "Archive renames the job folder to name.backup, with a timestamp suffix if that name is taken, so nothing is lost. Delete asks whether to also remove the folder from disk. Both are refused while the job is still placed on the workflow canvas."],
    ["Which sources can I add to a job?", "CSV, JSON, Parquet, MySQL, PostgreSQL, SQL Server, SQLite, PostgreSQL CDC, MySQL CDC, Snowflake, BigQuery, MongoDB and Web API: thirteen in Hydra ETL 0.22."],
    ["Which HTTP methods does the Web API source offer?", "GET, POST, PUT and DELETE, with GET selected by default."],
  ],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Create a job", '/studio/05-add-a-source/']],
});
---

<BaseLayout title="Create a job in Hydra Studio and add its source" exactTitle="Create a Job in Hydra Studio and Add a Source | Hydra ETL" description="Create a job in Hydra Studio, rename it, drop a CSV source and configure it, then read the database and Web API sources. Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="05-add-a-source"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

