---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-31-global-and-project-settings.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Hydra Studio settings: global preferences and project settings", description: "Find every Hydra Studio setting: global preferences, environments, execution order, parameters, secrets and triggers, and the file each one writes. Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/global-and-project-settings/',
  name: article.headline,
  steps: ["Open Global settings", "Read the Environments card", "Open Project settings", "Read the Execution order tab", "Read Parameters, Secrets and Triggers"],
  faq: [["What is the difference between Global settings and Project settings in Hydra Studio?", "Global settings apply to every project: the data viewer row count, the environments saved on your machine and the job sync interval. Project settings belong to one project and are written in its files: execution order, parameters, secrets and triggers."], ["Where does Studio save each setting?", "The editor preferences are kept in this browser. Environment variables go to ~/.hydra on your machine. The execution order goes to workflows/thread.yaml, parameters to parameters.yaml and environments/.yaml, secrets to .hydra/secrets and triggers to triggers.yaml."], ["Are secrets shared with my team through Git?", "No. Secrets are saved in .hydra/secrets and .hydra/secrets., which Git ignores, so they stay on this machine. Parameters, the execution order and triggers are project files that everyone who opens the project receives."], ["How do I open the settings of a project?", "Select Settings in the sidebar, then the Project settings tab, and choose a project in the list. You can also open the address /settings/project/, and append ?tab=parameters, secrets or triggers."], ["When do triggers run?", "Triggers run while hdrctl serve is running, which is Studio itself, or while hdrctl watch runs. The Studio panel states that they do not run in both on the same project."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Settings", '/studio/global-and-project-settings/']],
});
---

<BaseLayout title="Hydra Studio settings" exactTitle="Hydra Studio Settings: Global and Project | Hydra ETL" description="Find every Hydra Studio setting: global preferences, environments, execution order, parameters, secrets and triggers, and the file each one writes. Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="global-and-project-settings"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

