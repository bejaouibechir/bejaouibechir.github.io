---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-35-preview-the-execution-order.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Preview the execution order of a Hydra project", description: "Read the Preview diagram of workflows/thread.yaml in Hydra Studio: stages, parallel blocks, waits, loops and fallbacks. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/preview-the-execution-order/',
  name: article.headline,
  steps: ["Open Preview", "Read the legend", "See a wait, a timeout and a fallback"],
  faq: [["What does the Preview tab show?", "Preview draws the thread as a diagram, from left to right: one column per stage, parallel workflows stacked, waits as diamonds, loops as a dashed arrow and fallbacks as dashed blocks. It draws what is in the editor."], ["How do I see which workflows run in parallel?", "Parallel workflows are stacked in the same column. In our project, load_sales sits above load_stock, between prepare and report."], ["What do the clock and hourglass mean?", "The clock marks a wait before a workflow starts, and the hourglass its maximum duration. In our test the diagram showed 2s on load_stock and 30s on load_sales."], ["Does Preview run anything?", "No. It only draws the thread. To rehearse the order from a terminal without running workflows, use hdrctl run with --dry-run."], ["Can I open a workflow from the diagram?", "Yes, according to the legend under the diagram and the Studio source: a click on a block opens that workflow. This lesson did not click a block."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Execution order: Preview", '/studio/preview-the-execution-order/']],
});
---

<BaseLayout title="Preview the execution order of a Hydra project" exactTitle="Preview the Hydra Execution Order Before a Run | Hydra ETL" description="Read the Preview diagram of workflows/thread.yaml in Hydra Studio: stages, parallel blocks, waits, loops and fallbacks. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="preview-the-execution-order"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

