---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-55-start-a-project-with-a-webhook.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Start a Hydra ETL project from a webhook", description: "Declare a webhook trigger, create a token, run hdrctl serve and call the URL to start a project. Tested with Hydra ETL 0.22 on Windows.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/start-a-project-with-a-webhook/',
  name: article.headline,
  steps: ["Declare the trigger", "Create the token", "Start the server and register the project", "Call the webhook", "Read the refusals", "Read the history", "Add the webhook trigger in Studio", "Read the missing token", "Create the token"],
  faq: [["How do I start a Hydra ETL project from another system?", "Declare a trigger of type webhook, create its token with hdrctl trigger token NAME, run hdrctl serve, and call POST /api/projects/PROJECT_ID/triggers/NAME/webhook with the token in a header. In our test on Hydra ETL 0.22, a valid call answered 202 and the project ran in about 2.5 seconds."], ["Where do I put the token?", "In the header X-Hydra-Token, or in Authorization: Bearer. Both worked in our test. The token is stored as a secret named in the trigger, in .hydra/secrets of the project."], ["What answers do I get when the call is wrong?", "A call with no token answered 401, token required. A wrong token answered 401, invalid token. An unknown trigger name answered 404, no webhook trigger. We read the 503 answer, for a token that was never created, in the source and did not test it."], ["Can I send data with the webhook?", "According to the source, nothing from the request is passed to the project: the call only starts the run. We did not test sending a body."], ["Does the webhook trigger work with hdrctl watch?", "No. According to the list output, a webhook is called through hdrctl serve. hdrctl watch is for time, file and source triggers."], ["Can I create the webhook token in Hydra Studio?", "Yes. In the Triggers tab, the key button of a webhook row opens a box with a Create the token button. The token is shown once, with a PowerShell and a curl command, and it is saved as a project secret in .hydra/secrets."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Webhook trigger", '/studio/start-a-project-with-a-webhook/']],
});
---

<BaseLayout title="Start a Hydra ETL project from a webhook" exactTitle="Hydra Webhook Trigger: Start a Project by HTTP | Hydra ETL" description="Declare a webhook trigger, create a token, run hdrctl serve and call the URL to start a project. Tested with Hydra ETL 0.22 on Windows." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="start-a-project-with-a-webhook"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

