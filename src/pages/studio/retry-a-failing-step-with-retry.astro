---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-53-retry-a-failing-step-with-retry.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Retry a failing step with retry", description: "Add a retry policy with max, delay and exponential backoff to a Hydra ETL workflow step and read how long a run waits. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/retry-a-failing-step-with-retry/',
  name: article.headline,
  steps: ["Retry a step that passes the third time", "Read every attempt", "Let the retries run out", "Double the wait", "Check a typo"],
  faq: [["What does all-or-nothing mean in Hydra ETL?", "If a batch fails during a load, the destination keeps exactly what it had before the run. Nothing from the batches already processed is published."], ["Is all-or-nothing on by default?", "In replace mode, yes. In our test of a CSV destination in replace mode, the file kept its previous content after a failure in the third batch. The default differs by destination type, and the dialog states it in the label of the setting."], ["What happens with atomic set to false?", "The batches that succeeded stay in the destination. In our test the file held 2,001 lines, the header and the 2,000 rows of the first two batches."], ["Which batch failed in the test?", "The third. With batches of 1,000 rows, row 2,200 is the 200th row of the third batch, and the error message points at position 199 of that batch."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Retry Scope", '/studio/retry-a-failing-step-with-retry/']],
});
---

<BaseLayout title="Retry a failing step with retry" exactTitle="Hydra Retry Policy: Retry a Failing Step | Hydra ETL" description="Add a retry policy with max, delay and exponential backoff to a Hydra ETL workflow step and read how long a run waits. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="retry-a-failing-step-with-retry"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

