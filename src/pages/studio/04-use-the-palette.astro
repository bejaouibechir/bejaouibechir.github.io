---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-04-use-the-palette.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Hydra Studio node palette: sources, transformations, destinations and actions", description: "Tour the Hydra Studio node palette: 13 sources, 20 transformations, 10 destinations, actions, control flow and containers. Tested on Hydra ETL 0.22.", datePublished: '2026-11-04', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/04-use-the-palette/',
  name: article.headline,
  steps: ["Discover the palette", "Read what a workflow can do", "Tell someone, or tell something", "The palette knows which machine it runs on", "Run Python, on any host", "Reach outside the machine, and carry values across steps", "Steer the graph, and group what it holds", "Your own jobs become palette entries", "Read the connectors, in and out", "Twenty ways to reshape data", "Write the transformation that does not exist", "Give the canvas room"],
  faq: [["How many sources, transformations and destinations does Hydra Studio offer?", "In Hydra ETL 0.22 the job palette lists 13 sources, 20 transformations and 10 destinations. The workflow palette lists 9 actions, 2 control-flow nodes, 3 containers and the jobs of the project."], ["Which sources have no matching destination?", "Web API, PostgreSQL CDC and MySQL CDC are sources only. The other ten connectors work in both directions."], ["Why is Bash or PowerShell dimmed in the palette?", "Each shell action is tied to an operating system. Bash runs on Linux and macOS, PowerShell on Windows, and the other one is dimmed on your host."], ["What if no transformation fits my rule?", "Use the Script transformation: you declare the input and output columns and write the Python in between. It can run vectorized on whole columns or row by row."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Use the palette", '/studio/04-use-the-palette/']],
});
---

<BaseLayout title="Hydra Studio node palette: sources, transformations, destinations and actions" exactTitle="Hydra Studio Node Palette: Every Node Explained | Hydra ETL" description="Tour the Hydra Studio node palette: 13 sources, 20 transformations, 10 destinations, actions, control flow and containers. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="04-use-the-palette"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

