---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-33-create-a-workflow.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Create a workflow in a Hydra project with hdrctl", description: "Create an empty workflow with hdrctl workflow add, see where it lands in thread.yaml, list, check and remove it. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/create-a-workflow/',
  name: article.headline,
  steps: ["List the workflows", "Add a workflow", "Read the new file", "Check it and list again", "Let Hydra name it, then remove one"],
  faq: [["How do I create a workflow in a Hydra project?", "Run hdrctl workflow add in the project folder. It creates workflows/.yaml with no steps and a manual trigger, and adds the workflow at the end of the last stage of workflows/thread.yaml."], ["What happens if I give no name?", "Hydra invents one. In our test the name was workflow- followed by eight characters, workflow-109f7411, and the workflow was added like any other."], ["Does the new workflow run in the project?", "Yes, as soon as it is in the thread. A workflow with no steps runs in 0.0 seconds and counts 0 of 0 steps. The dry run lists it with a zero between parentheses."], ["How do I delete a workflow?", "Run hdrctl workflow remove . It asks for confirmation unless you add -y. It deletes the file and removes the workflow from workflows/thread.yaml. Jobs are not deleted."], ["Can I import an existing workflow file?", "According to the Studio source, a workflow file that sits in the workflows folder but not in thread.yaml is listed under Not in the thread in Execution order, where one click adds it. We did not test this with a file copied from elsewhere. The Studio Import button, which brings in a job, has its own lesson."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Create a workflow", '/studio/create-a-workflow/']],
});
---

<BaseLayout title="Create a workflow in a Hydra project" exactTitle="Hydra Create a Workflow: hdrctl workflow add | Hydra ETL" description="Create an empty workflow with hdrctl workflow add, see where it lands in thread.yaml, list, check and remove it. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="create-a-workflow"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

