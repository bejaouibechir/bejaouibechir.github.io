---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-38-repeat-workflows-with-loops.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Repeat Hydra workflows with loops in thread.yaml", description: "Repeat part of a project with loops in thread.yaml, pause between passes, and preview the plan with a dry run. Tested on Windows, Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/repeat-workflows-with-loops/',
  name: article.headline,
  steps: ["Write two small workflows", "Add a loop", "Preview the plan", "Run the project", "Change the number of passes"],
  faq: [["How do I repeat a workflow in Hydra?", "Add a loops list to workflows/thread.yaml. Each loop has a from workflow, a to workflow, times and an optional delay. Hydra replays the workflows from to up to from, in thread order."], ["Does times count the first run?", "Yes. times is the total number of passes. In our test, times: 2 over two workflows ran four workflows in all, and times: 3 ran six."], ["How do I pause between passes?", "Set delay on the loop, for example delay: 1s. The run prints a line saying it is waiting before the next pass. delay accepts seconds or durations such as 500ms, 30s, 5m or 1h."], ["Can I check a loop without running it?", "Yes. hdrctl run with --dry-run prints the execution plan, including a line for each loop with its passes and its wait, and runs nothing. It also confirms that the project is valid."], ["What happens if a workflow fails inside a loop?", "The engine's thread documentation says a failure stops the project, loops included. This lesson only ran successful workflows, so it did not reproduce a failure."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Loops and pauses", '/studio/repeat-workflows-with-loops/']],
});
---

<BaseLayout title="Repeat Hydra workflows with loops" exactTitle="Hydra thread.yaml Loops: Repeat Workflows | Hydra ETL" description="Repeat part of a project with loops in thread.yaml, pause between passes, and preview the plan with a dry run. Tested on Windows, Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="repeat-workflows-with-loops"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

