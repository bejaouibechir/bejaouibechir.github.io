---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-10-start-from-a-template.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Start from a Hydra Studio workflow template: View YAML and Copy YAML", description: "Open the three Hydra Studio workflow templates, read their YAML and copy the one you need. CSV to CSV, API to Database and Parallel ETL. Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/start-from-a-template/',
  name: article.headline,
  steps: ["Open the Templates page", "Read the YAML of CSV → CSV", "Tell the three templates apart", "Copy the template"],
  faq: [["What templates does Hydra Studio include?", "Hydra ETL 0.22 lists three workflow templates in the ETL category: CSV → CSV, API → Database and Parallel ETL. Each card shows a short description, its YAML and a button that copies the YAML."], ["Does a template create jobs for me?", "No. A template is a workflow file. It refers to jobs by path, for example ./jobs/extract and ./jobs/load, and does not include them: you create those jobs in your project."], ["How do I copy a template?", "Select Copy YAML on its card. Studio copies the whole workflow to the clipboard and shows Copied for a moment. Paste it into a workflow file of your project."], ["Which template runs on a schedule?", "API → Database. Its trigger is a schedule with the cron expression 0 8 * * *, and it ends with a webhook action that is skipped if it fails. The two other templates start manually."], ["What does depends_on do in a template?", "It makes a step wait for the steps it names. In Parallel ETL, the load step depends on both extractions, so it starts only after both finish."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Start from a template", '/studio/start-from-a-template/']],
});
---

<BaseLayout title="Start from a Hydra Studio template" exactTitle="Hydra Studio Workflow Templates | Hydra ETL" description="Open the three Hydra Studio workflow templates, read their YAML and copy the one you need. CSV to CSV, API to Database and Parallel ETL. Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="start-from-a-template"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

