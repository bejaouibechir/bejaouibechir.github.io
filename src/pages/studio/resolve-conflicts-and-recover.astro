---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-45-resolve-conflicts-and-recover.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Resolve a rollback conflict and recover in Hydra ETL", description: "When a rollback finds a file changed by someone else, Hydra ETL refuses to overwrite it. Read the journal and recover safely. Tested on Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/resolve-conflicts-and-recover/',
  name: article.headline,
  steps: ["Run the workflow and edit the file during the wait", "Read the failed rollback", "Try to run the workflow again", "Try to finish the undo", "Recover"],
  faq: [["Why did Hydra ETL not undo my step?", "The file it would restore changed after the run wrote it, by size or by date. Restoring the old version would destroy that change, so Hydra ETL leaves the file as it is."], ["Where does Hydra ETL keep what is left to undo?", "In .hydra/undo/ followed by the workflow name and .json, inside the project. The file lists each step still to undo."], ["Why can I not run the workflow again?", "Because a previous run stopped before undoing its changes. Running again could build on a half-undone state, so Hydra ETL asks you to finish the undo first."], ["Does putting the file back as it was fix the conflict?", "Not in our test. After removing our added line by hand, the undo still stopped, because the date of the file had changed as well."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Resolve conflicts and recover", '/studio/resolve-conflicts-and-recover/']],
});
---

<BaseLayout title="Resolve a rollback conflict and recover in Hydra ETL" exactTitle="Resolve a Rollback Conflict in Hydra ETL | Hydra ETL" description="When a rollback finds a file changed by someone else, Hydra ETL refuses to overwrite it. Read the journal and recover safely. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="resolve-conflicts-and-recover"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

