---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-18-read-the-insights-statistics.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Read the Insights statistics of Hydra Studio", description: "What the Hydra Studio Insights page counts: total, successful, failed and running runs and the average duration, and why it resets. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/read-the-insights-statistics/',
  name: article.headline,
  steps: ["Start a few runs", "Open Insights", "Match them with the Runs page", "Know the limits"],
  faq: [["What does the Insights page show in Hydra Studio?", "Insights shows four counters, for total, successful, failed and running runs, and one card with the average duration in seconds. The numbers are computed in the browser from the list of runs."], ["How is the average duration computed?", "As the mean of the durations of all the runs that have one, failed runs included. In our test, runs of 3.1, 0.1 and 0.0 seconds gave 1.1 seconds."], ["Why are my Insights counters back to zero?", "The server keeps the list of runs in memory. After you restart hdrctl serve, the Runs page and Insights start empty again. We saw this after restarting Studio."], ["Does Insights count runs started from the terminal?", "No. It counts the runs that the Studio server knows about, such as runs started from the Run buttons or the API. A run started with hdrctl run in a terminal is not in the list."], ["Can I see statistics per workflow?", "Not in Hydra ETL 0.22. Insights shows project-wide totals only. The Runs page lists each run with its workflow, status, steps and duration, and its filter tabs narrow the list by status."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Insights", '/studio/read-the-insights-statistics/']],
});
---

<BaseLayout title="Read the Insights statistics of Hydra Studio" exactTitle="Hydra Studio Insights: Run Counters Explained | Hydra ETL" description="What the Hydra Studio Insights page counts: total, successful, failed and running runs and the average duration, and why it resets. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="read-the-insights-statistics"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

