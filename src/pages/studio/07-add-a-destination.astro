---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-07-add-a-destination.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Add a destination in Hydra Studio: one job, one place to write", description: "Add a destination to a Hydra Studio job: the ten connectors, the CSV dialog, and why a pipeline names exactly one. Hydra ETL 0.22.", datePublished: '2026-11-04', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/07-add-a-destination/',
  name: article.headline,
  steps: ["Read the ten destinations", "Open the CSV destination", "One destination, and only one"],
  faq: [["Which destinations does Hydra Studio offer?", "CSV, JSON, Parquet, MySQL, PostgreSQL, SQL Server, SQLite, Snowflake, BigQuery and MongoDB: ten in Hydra ETL 0.22."], ["Can a Hydra job write to two destinations?", "No. The pipeline names a single destination in its to key. We declared a second destination without referencing it and it was ignored; we wrote to as a list and hdrctl validate rejected it. To write to two places, use two jobs in a workflow."], ["Why is there no Web API destination?", "Web API is a source only in Hydra ETL 0.22, like PostgreSQL CDC and MySQL CDC. To send data out over HTTP, use the Webhook action in the workflow scene."], ["How do I keep a password out of a destination?", "Write a reference such as ${ENV:MY_SECRET} in the field and keep the value under Environments, never in the manifest."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Destinations", '/studio/07-add-a-destination/']],
});
---

<BaseLayout title="Add a destination in Hydra Studio: one job, one place to write" exactTitle="Hydra Studio Destinations: Close a Job Correctly | Hydra ETL" description="Add a destination to a Hydra Studio job: the ten connectors, the CSV dialog, and why a pipeline names exactly one. Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="07-add-a-destination"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

