---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-30-store-and-use-secrets-with-hdrctl.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Store and use secrets in a Hydra ETL project", description: "Store a token with hdrctl secret, read it with SECRET placeholders, and choose masked, hidden or plain logs. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/store-and-use-secrets-with-hdrctl/',
  name: article.headline,
  steps: ["Store a secret", "Use it in a workflow", "Choose what the logs show", "Let an environment variable win", "Keep one secret per environment", "Read the errors, then delete"],
  faq: [["Where does Hydra ETL store secrets?", "In the file .hydra/secrets of the project, one name=value per line. hdrctl secret set writes it for you. The file is in clear text, and the .gitignore created by hdrctl init lists it, so that it is not committed."], ["How do I use a secret in a job or a workflow?", "Write ${SECRET:name} where the value goes, for example ${SECRET:api.token}. Hydra replaces it when the job or workflow runs. We tested it in a log step of a workflow."], ["Are secret values shown in the logs?", "By default they are replaced by [MASKED]. With --secrets-visibility hidden the line that contains a secret is removed and a message counts the removed lines. With plain the value is shown, and Hydra warns that it is for debugging only."], ["What wins when the secret is also an environment variable?", "The environment variable. ${SECRET:api.token} first reads API_TOKEN from the environment, then the file. In our test, API_TOKEN set in the shell replaced the value of the file."], ["How do I keep a different secret per environment?", "Add --env to the command: hdrctl secret set api.token --env prod writes .hydra/secrets.prod. A run with --env prod then reads that value first. We tested it with hdrctl workflow run."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Secrets", '/studio/store-and-use-secrets-with-hdrctl/']],
});
---

<BaseLayout title="Store and use secrets in a Hydra ETL project" exactTitle="Hydra Secrets: hdrctl secret Command | Hydra ETL" description="Store a token with hdrctl secret, read it with SECRET placeholders, and choose masked, hidden or plain logs. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="store-and-use-secrets-with-hdrctl"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

