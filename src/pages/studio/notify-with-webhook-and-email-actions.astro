---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-27-notify-with-webhook-and-email-actions.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Send a webhook and an email from a Hydra ETL workflow", description: "Call a URL with the webhook action and send a message with the email action, test both locally and read the errors. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/notify-with-webhook-and-email-actions/',
  name: article.headline,
  steps: ["Start a local test server", "Send a webhook", "Check what the server received", "Read the webhook errors", "Send an email", "Check the email and its failures"],
  faq: [["How do I call a URL from a Hydra ETL workflow?", "Add a step of type action with action webhook and the params url, method, headers and body. The step sends the request and succeeds when the server answers with a 2xx status. In our test on Hydra ETL 0.22 on Windows, a POST with a JSON body reached a local server in 0.1 seconds."], ["How do I write headers and body in the YAML?", "As text that holds JSON, for example headers: \"{\\\"X-Demo\\\": \\\"yes\\\"}\". Studio saves them that way. According to the source, a YAML object is accepted too, but we tested the text form only. The request always carries Content-Type: application/json."], ["What happens when the server answers 404 or is down?", "The step fails with the error of the HTTP client: HTTPError: HTTP Error 404: Not Found, or URLError with the connection error. The text of a connection error follows the language of your system."], ["How do I send an email from a workflow?", "Use action email with smtp_host, smtp_port, to, subject and body. It sends through an SMTP server. We tested it against a local test server on port 1025, and the message arrived with the right sender, recipient and subject."], ["Which parameters are required?", "url for a webhook and to for an email. Without them, hdrctl workflow run stops before the run with: action 'webhook' requires parameter 'url', or action 'email' requires parameter 'to'."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Actions 2", '/studio/notify-with-webhook-and-email-actions/']],
});
---

<BaseLayout title="Send a webhook and an email from a Hydra ETL workflow" exactTitle="Hydra Webhook and Email Actions in a Workflow | Hydra ETL" description="Call a URL with the webhook action and send a message with the email action, test both locally and read the errors. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="notify-with-webhook-and-email-actions"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

