---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-12-compose-jobs.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Compose jobs into an ordered workflow in Hydra Studio", description: "Order two jobs in a Hydra Studio workflow with an edge, run the pair and learn what depends_on does and does not do. Tested on Hydra ETL 0.22.", datePublished: '2026-11-04', dateModified: '2026-11-22', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/12-compose-jobs/',
  name: article.headline,
  steps: ["Bring in a second job", "Order the two with an edge", "Run the pair", "Read what the arrow did not do", "Read the composition as YAML"],
  faq: [
    ["Does an edge between two jobs pass data?", "No. It only orders the jobs. If the second job needs the first job's output, the first job must write it to a file or table that the second job reads."],
    ["How is an edge written in workflow.yaml?", "As a depends_on list on the later step, naming the earlier step."],
    ["How is a job step written in workflow.yaml?", "As a step with type: job and a job: path, such as job: ../jobs/first-job."],
    ["Can a workflow hold more than two jobs?", "Yes. A workflow does not care how many jobs it holds, only how they are ordered."],
  ],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Compose jobs", '/studio/12-compose-jobs/']],
});
---

<BaseLayout title="Compose jobs into an ordered workflow in Hydra Studio" exactTitle="Order Jobs in a Hydra Studio Workflow | Hydra ETL" description="Order two jobs in a Hydra Studio workflow with an edge, run the pair and learn what depends_on does and does not do. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="12-compose-jobs"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

