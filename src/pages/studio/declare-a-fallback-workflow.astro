---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-46-declare-a-fallback-workflow.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Declare a fallback workflow in Hydra ETL Studio", description: "Declare a fallback workflow in Hydra ETL Studio: pick a backup, write the when condition, check it and see it take over. Tested on Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/declare-a-fallback-workflow/',
  name: article.headline,
  steps: ["Open the execution order", "Add a fallback to the workflow", "Choose the replacement and write the condition", "Preview the result", "Save, then check the project", "Run it and read the switch"],
  faq: [
    ["What is a fallback workflow in Hydra ETL?", "A workflow that runs only in place of another one, when a condition written in thread.yaml is true just before the main workflow would start."],
    ["Where is a fallback declared?", "In workflows/thread.yaml, as a fallback block with use (the replacement workflows) and when (the condition) under the workflow it protects."],
    ["Does a fallback run when a workflow fails?", "Only if the fallback sets on_failure: true, which Studio shows as the also after a failure checkbox. Without it, the condition is the only trigger."],
    ["Can I test a fallback without running anything?", "Yes. hdrctl run . --dry-run prints the plan, including a fallback line under each workflow that has one, and writes nothing."],
  ],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Declare a fallback workflow", '/studio/declare-a-fallback-workflow/']],
});
---

<BaseLayout title="Declare a fallback workflow in Hydra ETL Studio" exactTitle="Declare a Fallback Workflow in Hydra ETL Studio | Hydra ETL" description="Declare a fallback workflow in Hydra ETL Studio: pick a backup, write the when condition, check it and see it take over. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="declare-a-fallback-workflow"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

