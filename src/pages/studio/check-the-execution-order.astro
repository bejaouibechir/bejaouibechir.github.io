---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-36-check-the-execution-order.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Check the execution order of a Hydra project for errors", description: "Press Check in Hydra Studio to validate workflows/thread.yaml before a run: the green Ready line, and the red message for a missing workflow. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/check-the-execution-order/',
  name: article.headline,
  steps: ["Check a valid thread", "Break the thread on purpose", "Press Check", "Fix and check again"],
  faq: [["What does Check do in Execution order?", "Check validates the project before any run. It reports a green Ready line when the thread is usable, or red lines naming the problem. According to the Hydra source, it looks for missing workflow files, workflows that cannot be loaded, missing job folders and missing fallback files."], ["What does the Ready line mean?", "It lists the active workflows in order and the number of loops, for example prepare, load_sales, load_stock, report and one loop. In our test it appeared in green under the Loops box."], ["How is a missing workflow reported?", "As a red line: workflows/thread.yaml: workflow 'ghost' has no file workflows/ghost.yaml. In the Define tab the workflow is also tagged file missing."], ["Does Check run my workflows?", "No. It validates the files before a run and runs nothing. A dry run from the terminal, hdrctl run --dry-run, gives the same safety with a printed plan."], ["Does Check save my changes?", "Yes, when there are unsaved changes. According to the Studio source, Check saves first and then validates. The button is disabled while a wait or loop value is invalid."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Execution order: Check", '/studio/check-the-execution-order/']],
});
---

<BaseLayout title="Check the execution order of a Hydra project" exactTitle="Check the Hydra Execution Order for Errors | Hydra ETL" description="Press Check in Hydra Studio to validate workflows/thread.yaml before a run: the green Ready line, and the red message for a missing workflow. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="check-the-execution-order"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

