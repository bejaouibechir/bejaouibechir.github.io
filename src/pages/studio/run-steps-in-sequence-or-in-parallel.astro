---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-37-run-steps-in-sequence-or-in-parallel.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Run Hydra workflows in sequence or in parallel with stages", description: "Declare stages in thread.yaml, run workflows in sequence or in parallel with hdrctl run, and compare timings. Tested on Windows, Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/run-steps-in-sequence-or-in-parallel/',
  name: article.headline,
  steps: ["Write four small workflows", "Declare the stages", "Run the project", "Compare with a sequential stage", "Skip a workflow"],
  faq: [["What is a stage in thread.yaml?", "A stage is one entry of the thread list in workflows/thread.yaml. It has a mode, sequential or parallel, and a list of workflows. Stages run one after the other, and hdrctl run reads them in order."], ["How do I run two workflows at the same time in Hydra?", "Put them in the same stage with mode: parallel. In our test, two workflows of 2.2 seconds each finished together, and the whole project took 3.3 seconds instead of 5.4 with the same stage set to sequential."], ["What does delay_after do?", "delay_after pauses the project after a stage, before the next one starts. It takes a number of seconds or a duration such as 500ms, 30s, 5m or 1h. The run prints a line saying it is waiting."], ["How do I skip a workflow without deleting it?", "Add active: false to the workflow in thread.yaml. The run prints that the workflow is inactive and skipped, and counts only the others. In our test, 3 of 3 remaining workflows ran."], ["What happens when a workflow in a stage fails?", "The Studio Execution order page states that a failed workflow stops the project. This lesson only ran successful workflows, so it did not reproduce a failure."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Stages", '/studio/run-steps-in-sequence-or-in-parallel/']],
});
---

<BaseLayout title="Run Hydra workflows in sequence or in parallel" exactTitle="Hydra Stages: Sequential and Parallel Workflows | Hydra ETL" description="Declare stages in thread.yaml, run workflows in sequence or in parallel with hdrctl run, and compare timings. Tested on Windows, Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="run-steps-in-sequence-or-in-parallel"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

