---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-51-wait-with-the-delay-node.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Wait with the Hydra Studio Delay node: pause a workflow for N seconds", description: "Pause a Hydra ETL workflow with the Delay node. Set the seconds, read the YAML, and run it to see the pause. Commands tested on Windows, Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/wait-with-the-delay-node/',
  name: article.headline,
  steps: ["Find the Delay node", "Write a workflow with a pause", "Validate the workflow", "Run it and watch the pause"],
  faq: [["What does the Delay node do in Hydra Studio?", "It pauses the workflow for a number of seconds before the steps that depend on it can start. Its only required setting is Delay (seconds)."], ["What is the YAML of a Delay step?", "A step with type action, action delay and a params block holding seconds. In our test a step named pause with seconds: 3 completed in 3.0s."], ["Can the delay be shorter than a second?", "Yes. The engine reads the value as a decimal number, so 0.5 waits half a second. A negative value is treated as zero."], ["What happens if seconds is not a number?", "The engine stops with an error that names the step and says seconds must be a number. Studio marks the field as required."], ["Can I use a parameter for the delay?", "Yes. The field has a {x} button that inserts a parameter reference, so the pause can change from one run to the next."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Delay", '/studio/wait-with-the-delay-node/']],
});
---

<BaseLayout title="Wait with the Hydra Studio Delay node" exactTitle="Hydra Studio Delay Node: Pause a Workflow | Hydra ETL" description="Pause a Hydra ETL workflow with the Delay node. Set the seconds, read the YAML, and run it to see the pause. Commands tested on Windows, Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="wait-with-the-delay-node"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

