---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-34-define-the-execution-order.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Define the execution order of a Hydra project in Studio", description: "Edit workflows/thread.yaml from Studio: stages, parallel mode, waits, skipped workflows and loops in the Define tab. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/define-the-execution-order/',
  name: article.headline,
  steps: ["Open Execution order", "Read a stage", "Add a workflow", "Repeat part of the thread", "Save, then check"],
  faq: [["Where do I edit the execution order in Hydra Studio?", "Open Settings, then Project settings, then the Execution order tab, and keep Define selected. The tab edits the file workflows/thread.yaml of the project, which hdrctl run reads."], ["How do I add a workflow to the thread in Studio?", "Workflows that exist in the project but are not in the thread are listed after the words Not in the thread. Click one to add it at the end. The Save button then becomes active."], ["How do I skip a workflow without deleting it?", "Untick the checkbox in front of its name. Studio treats an unticked workflow as skipped. The cross at the end of its row removes it from the thread and keeps the workflow file."], ["Does the execution order apply to a single workflow?", "No. It orders the workflows of a whole project. A workflow run on its own from the canvas, or with hdrctl workflow run, does not use thread.yaml."], ["What happens if I leave the page with unsaved changes?", "Studio asks for confirmation before you leave or reload the tab, according to the Studio source. This lesson did not trigger that prompt."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Execution order: Define", '/studio/define-the-execution-order/']],
});
---

<BaseLayout title="Define the execution order of a Hydra project" exactTitle="Hydra Execution Order: Define Stages in Studio | Hydra ETL" description="Edit workflows/thread.yaml from Studio: stages, parallel mode, waits, skipped workflows and loops in the Define tab. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="define-the-execution-order"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

