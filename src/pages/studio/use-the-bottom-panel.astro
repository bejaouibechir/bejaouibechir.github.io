---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-07-use-the-bottom-panel.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Use the Hydra Studio bottom panel: Logs, Parameters, Secrets and Terminal", description: "Use the Hydra Studio bottom panel: read the Logs, edit Parameters, store Secrets and run commands in the Terminal. Tested on Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/use-the-bottom-panel/',
  name: article.headline,
  steps: ["Open the panel", "Read the Logs tab", "Open the Parameters tab", "Open the Secrets tab", "Run a command in the Terminal"],
  faq: [["How do I open the bottom panel in Hydra Studio?", "Select the Logs panel button, the terminal icon at the bottom of the vertical toolbar beside the canvas. The panel also opens by itself when you run a job or a workflow. The cross at its right edge closes it."], ["What are the four tabs of the bottom panel?", "LOGS shows the log of the last run, PARAMETERS edits the project parameters, SECRETS stores secret values for the project, and TERMINAL opens a shell inside Studio."], ["Where does Studio store the parameters and the secrets?", "Parameter defaults are written to parameters.yaml and each environment column to environments/.yaml. Secrets go to .hydra/secrets, a file that Git ignores, and their values are never displayed."], ["How do I use a parameter or a secret in a field?", "Write {{ param:name }} for a parameter, or params[\"name\"] in a Script node, and ${SECRET:name} for a secret. An environment variable named in upper case, such as DB_PASSWORD for db.password, wins over the file."], ["Can I resize the bottom panel?", "Yes. Drag the thin splitter on its top edge. In Hydra ETL 0.22 the height stays between 120 and 520 pixels."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Use the bottom panel", '/studio/use-the-bottom-panel/']],
});
---

<BaseLayout title="Use the Hydra Studio bottom panel" exactTitle="Hydra Studio Bottom Panel: Logs, Secrets | Hydra ETL" description="Use the Hydra Studio bottom panel: read the Logs, edit Parameters, store Secrets and run commands in the Terminal. Tested on Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="use-the-bottom-panel"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

