---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-09-reach-valid.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Hydra Studio Valid badge: what it checks and what it does not", description: "Understand the Hydra Studio Valid badge: it checks the job graph, not every node. Build CSV, Cast, Filter, CSV until both are green. Hydra ETL 0.22.", datePublished: '2026-11-04', dateModified: '2026-11-22', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/09-reach-valid/',
  name: article.headline,
  steps: ["Add and configure Cast", "Add and configure Filter", "Add the CSV destination", "Connect and verify both layers"],
  faq: [["What does the Valid badge mean in Hydra Studio?", "It comes from graph validation: no duplicated IDs, no unknown dependencies and no cycle. It says nothing about whether each node has its required fields."], ["Why is my job valid but a node still has a red badge?", "Node badges check that the node is configured, which the header badge does not. Open the node and fill the field marked with a red asterisk."], ["Does a valid job always run successfully?", "No. Valid is a design-time check before any data moves. Run the job to prove it works, then read the result on the Runs page."], ["What does a Cast node need?", "A Types (JSON) mapping from column to type, for example {\"price\":\"float\",\"qty\":\"int\"}."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Reach Valid", '/studio/09-reach-valid/']],
});
---

<BaseLayout title="Hydra Studio Valid badge: what it checks and what it does not" exactTitle="Hydra Studio Valid Badge: What It Checks | Hydra ETL" description="Understand the Hydra Studio Valid badge: it checks the job graph, not every node. Build CSV, Cast, Filter, CSV until both are green. Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="09-reach-valid"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

