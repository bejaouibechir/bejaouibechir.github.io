---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-52-handle-step-failures-with-on-failure.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Handle a failing step with on_failure", description: "Set on_failure to fail, skip or continue on a Hydra ETL workflow step and see what each does to the steps after it. Tested with Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/handle-step-failures-with-on-failure/',
  name: article.headline,
  steps: ["Write a workflow with a failing step", "Try skip", "Try continue", "Read the end of the run", "Check a wrong value"],
  faq: [["What does on_failure do in a Hydra ETL workflow?", "It sets what happens to the rest of the workflow when this step fails. The values are fail (the default), skip and continue. In our test on Hydra ETL 0.22, fail stopped the workflow and left the steps after it unrun, skip ran the steps that did not depend on the failed step, and continue also ran the steps that did."], ["What is the difference between skip and continue?", "With skip, the steps that depend on the failed step are skipped. With continue, they run anyway. In both cases the steps that do not depend on it run, in our test."], ["Does the workflow succeed when I use skip or continue?", "Not in our test. With skip and with continue the run still ended as FAILED, with exit code 1 and an empty reason (None), because one step had failed. According to the source, the workflow succeeds only if every step succeeded."], ["How does the Error Scope container of Studio relate to this?", "According to the Studio source (workflowSerializer.ts), an Error Scope copies its on_failure value onto each step it contains, so the YAML carries the same key. We did not test dragging steps into the container."], ["What does Hydra ETL say when the value is wrong?", "Validation refuses it and lists the three values: Input should be 'fail', 'skip' or 'continue'."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Error Scope", '/studio/handle-step-failures-with-on-failure/']],
});
---

<BaseLayout title="Handle a failing step with on_failure" exactTitle="Hydra on_failure: Fail, Skip or Continue | Hydra ETL" description="Set on_failure to fail, skip or continue on a Hydra ETL workflow step and see what each does to the steps after it. Tested with Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="handle-step-failures-with-on-failure"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

