---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductLearningShell from '../../components/ProductLearningShell.astro';
import { studioLessons } from '../../data/studio-lessons.js';
import css from '../../_mock/learning-hub.css?raw';
import lessonCss from '../../_mock/cli-lesson.css?raw';
import js from '../../_mock/learning-hub.js?raw';
import main from '../../_mock/studio-lesson-26-log-python-and-shell-actions.main.html?raw';
import { lessonJsonLd } from '../../data/lesson-jsonld.js';
const article = { headline: "Run Log, Python and shell actions in a Hydra Studio workflow", description: "Run Log, Python and PowerShell actions in a Hydra ETL workflow: read the dialogs, write the YAML and run it. Commands tested on Windows, Hydra ETL 0.22.", datePublished: '2026-11-23', dateModified: '2026-11-23', author: 'Bechir Bejaoui' };
const jsonld = lessonJsonLd({
  path: '/studio/log-python-and-shell-actions/',
  name: article.headline,
  steps: ["Open the Log action", "Open the Python action", "Open the PowerShell action", "Write a workflow with three actions", "Validate and run"],
  faq: [["What actions can a Hydra workflow run?", "Hydra ETL 0.22 has eleven actions: bash, powershell, python, ssh, webhook, email, log, delay, condition, set_param and assign_param. A step runs one of them with type action, an action name and a params block."], ["How do I run a Python script in a workflow?", "Use the python action with an inline script in params.script, or a .py file in params.file_path. Optional keys are working_dir and timeout, which defaults to 60 seconds."], ["Why is the Bash action unavailable on Windows?", "Each shell action is tied to an operating system: Bash runs on Linux and macOS, PowerShell on Windows. The palette shows the other one dimmed. Use Python when a step must run everywhere."], ["Where does the output of a step go?", "The log action writes its message to the run, and a Python or PowerShell step shows what it prints under the step. In our test each message appeared right below its step."], ["What does On failure do?", "Every action dialog has an On failure list whose default is fail. It decides what the workflow does when the step fails. The Resolve conflicts and recover lessons cover the other choices."]],
  crumbs: [['Get started', '/get-started'], ['Hydra Studio', '/studio'], ["Actions 1", '/studio/log-python-and-shell-actions/']],
});
---

<BaseLayout title="Log, Python and shell actions in Hydra Studio" exactTitle="Hydra Workflow Actions: Log, Python, PowerShell | Hydra ETL" description="Run Log, Python and PowerShell actions in a Hydra ETL workflow: read the dialogs, write the YAML and run it. Commands tested on Windows, Hydra ETL 0.22." article={article} jsonld={jsonld}>
  <style is:global set:html={css}></style>
  <style is:global set:html={lessonCss}></style>
  <ProductLearningShell
    product="Studio"
    title="Hydra Studio tutorials"
    lead="Learn the visual path from an empty canvas to generated YAML, a validated design and a run you can inspect node by node."
    duration="about 90 minutes"
    lessons={studioLessons}
    activeSlug="log-python-and-shell-actions"
    referenceHref="/playground"
    referenceLabel="Explore a job without installing"
  >
    <Fragment set:html={main} />
  </ProductLearningShell>
  <script is:inline set:html={js}></script>
</BaseLayout>

