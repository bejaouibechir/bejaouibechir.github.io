---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import TrackNav from '../../components/academy/TrackNav.astro';
import { liveTracks, tracks, trackMinutes } from '../../data/academy.js';

export function getStaticPaths() {
  return liveTracks.map((track) => ({ params: { track: track.id }, props: { track } }));
}

const { track } = Astro.props;
const SITE_UTM = '?utm_source=hydraetl&utm_medium=academy&utm_campaign=' + track.id;
const listId = track.playlist.split('list=')[1];

/* Parcours suivant dans l'ordre d'apprentissage : ouvert, ou annonce. */
const index = tracks.findIndex((t) => t.id === track.id);
const next = tracks[index + 1];
---

<BaseLayout
  title={`${track.title} — Hydra Academy`}
  description={`${track.title} video track of Hydra Academy: ${track.videos.length} short videos, each paired with a Killercoda lab. ${track.tagline}`}
>
  <main class="ac">
    <TrackNav current={track.id} />

    <section class="ac-track">
      <div class="ac-wrap">
        <p class="ac-crumbs"><a href="/academy/">Hydra Academy</a> <span aria-hidden="true">/</span> {track.title}</p>
        <div class="ac-track-head">
          <div>
            <h1>{track.title}</h1>
            <p>{track.lead}</p>
            <p class="ac-meta">{track.videos.length} videos · {trackMinutes(track)} min</p>
          </div>
          <a class="ac-btn" href={track.playlist} target="_blank" rel="noopener" data-umami-event="playlist-click" data-umami-event-track={track.id}>
            Full playlist on YouTube
          </a>
        </div>

        <ol class="ac-list">
          {track.videos.map((v, i) => (
            <li class="ac-item" id={`v-${v.youtube}`}>
              <VideoFacade id={v.youtube} title={v.title} thumb={v.thumb} duration={v.duration} location={`academy-${track.id}`} />
              <div class="ac-body">
                <span class="ac-num">{String(i + 1).padStart(2, '0')}</span>
                <h2>{v.title}</h2>
                <p>{v.summary}</p>
                <ul>
                  {v.steps.map((s) => <li set:html={s} />)}
                </ul>
                <div class="ac-actions">
                  <a class="ac-btn ac-primary" href={v.lab.url + SITE_UTM} target="_blank" rel="noopener" data-umami-event="killercoda-click" data-umami-event-location={`academy-${track.id}`}>
                    Try it: {v.lab.label}
                  </a>
                  <a class="ac-link" href={`https://www.youtube.com/watch?v=${v.youtube}&list=${listId}`} target="_blank" rel="noopener">Watch on YouTube</a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ac-next">
      <div class="ac-wrap">
        {next ? (
          next.status === 'live' ? (
            <a class="ac-next-card" href={`/academy/${next.id}/`}>
              <span>Next track</span>
              <b>{next.title} →</b>
              <small>{next.tagline}</small>
            </a>
          ) : (
            <div class="ac-next-card ac-next-soon">
              <span>Next track · coming soon</span>
              <b>{next.title}</b>
              <small>{next.tagline}</small>
            </div>
          )
        ) : null}
        <a class="ac-link" href="/academy/">← All tracks</a>
      </div>
    </section>
  </main>

  <style>
    .ac-wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); }
    .ac-track { padding: 28px 0 20px; }
    .ac-crumbs { margin: 0 0 14px; color: var(--text-mut); font-size: .85rem; }
    .ac-crumbs a { color: var(--accent-text); text-decoration: none; font-weight: 600; }
    .ac-track-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
    .ac-track-head h1 { margin: 0 0 8px; font-size: clamp(1.8rem, 3.6vw, 2.5rem); line-height: 1.1; letter-spacing: -.02em; }
    .ac-track-head p { margin: 0; max-width: 44em; color: var(--text-soft); }
    .ac-track-head .ac-meta { margin-top: 8px; color: var(--text-mut); font-size: .9rem; }
    .ac-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 34px; }
    .ac-item { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 28px; align-items: start; scroll-margin-top: 130px; }
    .ac-num { color: var(--accent-text); font: 800 12px var(--mono); }
    .ac-body h2 { margin: 4px 0 8px; font-size: 1.2rem; line-height: 1.3; }
    .ac-body p { margin: 0 0 10px; color: var(--text-soft); }
    .ac-body ul { margin: 0 0 16px; padding-left: 1.1em; color: var(--text-soft); font-size: .95rem; }
    .ac-body li { margin: 3px 0; }
    .ac-body code { font-size: .88em; }
    .ac-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
    .ac-btn, .ac-link { text-decoration: none; }
    .ac-btn { color: var(--text); display: inline-flex; align-items: center; padding: 9px 14px; border: 1px solid var(--border-strong); border-radius: 9px; font-weight: 650; font-size: .92rem; white-space: nowrap; }
    .ac-btn:hover { border-color: var(--accent); }
    .ac-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .ac-primary:hover { filter: brightness(1.06); }
    .ac-link { color: var(--accent-text); font-size: .92rem; font-weight: 600; }
    .ac-link:hover { text-decoration: underline; }
    .ac-next { padding: 28px 0 64px; }
    .ac-next .ac-wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
    .ac-next-card { display: flex; flex-direction: column; gap: 4px; width: 100%; max-width: 520px; padding: 18px 20px; border: 1px solid var(--border); border-radius: 14px; color: inherit; text-decoration: none; transition: border-color .15s ease; }
    a.ac-next-card:hover { border-color: var(--accent); }
    .ac-next-card span { color: var(--accent-text); font: 800 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; }
    .ac-next-card b { font-size: 1.15rem; }
    .ac-next-card small { color: var(--text-soft); font-size: .9rem; }
    .ac-next-soon { background: var(--bg-soft); }
    @media (max-width: 820px) {
      .ac-track-head { display: block; }
      .ac-track-head .ac-btn { margin-top: 14px; }
      .ac-item { grid-template-columns: 1fr; gap: 16px; }
      .ac-btn { white-space: normal; }
    }
  </style>
</BaseLayout>
