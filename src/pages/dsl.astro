---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhitebookFrame from '../components/WhitebookFrame.astro';
import { whitebookChapters } from '../data/whitebook-chapters';
---

<BaseLayout title="Hydra DSL White Book" description="The complete Hydra DSL White Book: jobs, transformations, workflows, actions, parameters and secrets, with diagrams, labs and runnable examples.">
  <WhitebookFrame>
    <div class="wb-hero">
      <p class="wb-kicker">THE COMPLETE GUIDE · HYDRA DSL 1.0</p>
      <h1>Build data pipelines you can read.</h1>
      <p>Learn the Hydra DSL from its first YAML file to complete projects. Follow six articles with diagrams, hands-on Killercoda labs, runnable GitHub examples and downloadable ZIP files.</p>
      <div class="wb-hero-actions">
        <a class="wb-primary" href="/dsl/01-basics/">Start reading →</a>
        <a class="wb-secondary" href="/dsl/02-jobs-part1/">Explore jobs</a>
      </div>
    </div>
    <h2 class="wb-section-title">Read the White Book</h2>
    <div class="wb-chapter-grid">
      {whitebookChapters.map((chapter) => (
        <a class="wb-chapter-card" href={'/dsl/' + chapter.slug + '/'}>
          <span class="number">{chapter.number} / CHAPTER</span>
          <h3>{chapter.title}</h3>
          <p>{chapter.description}</p>
        </a>
      ))}
    </div>
  </WhitebookFrame>
</BaseLayout>
