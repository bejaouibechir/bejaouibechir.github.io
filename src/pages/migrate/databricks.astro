---
import BaseLayout from '../../layouts/BaseLayout.astro';
import css from '../../_mock/tunnel.css?raw';
import body from '../../_mock/tunnel-databricks.body.html?raw';
import js from '../../_mock/tunnel-databricks.js?raw';
---

