---
import BaseLayout from '../../layouts/BaseLayout.astro';
import css from '../../_mock/tunnel.css?raw';
import body from '../../_mock/tunnel-dbt.body.html?raw';
import js from '../../_mock/tunnel-dbt.js?raw';
---

<BaseLayout title="Migrate from dbt" description={"dbt + Hydra. Paste a dbt file and get the loading layer dbt assumes already exists."}>
  <style is:global set:html={css}></style>
  <Fragment set:html={body} />
  <script is:inline set:html={js}></script>
</BaseLayout>
