---
import BaseLayout from '../layouts/BaseLayout.astro';
import css from '../_mock/migrate.css?raw';
import body from '../_mock/migrate.body.html?raw';
import js from '../_mock/migrate.js?raw';
---

<BaseLayout title="Hydra vs Airflow, dbt, Dagster, Prefect, Airbyte" description={"Airflow vs Hydra, Dagster vs Hydra, Prefect vs Hydra, dbt, Databricks, Airbyte, Flowman, NiFi — the same pipeline, measured head to head."}>
  <style is:global set:html={css}></style>
  <Fragment set:html={body} />
  <script is:inline set:html={js}></script>
</BaseLayout>
