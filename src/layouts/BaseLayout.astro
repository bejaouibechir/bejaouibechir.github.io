---
import '../styles/global.css';
import SiteSearch from '../components/SiteSearch.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import mobileFixes from '../styles/mobile-fixes.css?raw';
import sideToggleJs from '../scripts/side-toggle.js?raw';
import version from '../data/version.json';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative social image (1200x630). */
  image?: string;
  /** Keep the page out of search engines. */
  noindex?: boolean;
  /** Add SoftwareApplication structured data (product pages). */
  software?: boolean;
  /** Use this exact <title>, bypassing the "— Hydra ETL" suffix.
   *  The home page leads with the brand, so it ranks for the brand query. */
  exactTitle?: string;
  /** Blog post: adds TechArticle structured data. Dates are ISO strings. */
  article?: {
    headline: string;
    description?: string;
    datePublished: string;
    dateModified?: string;
    author: string;
  };
  /** Extra JSON-LD nodes (HowTo, FAQPage, BreadcrumbList) matching the visible page. */
  jsonld?: Record<string, unknown>[];
}

const { title, description, image = '/og/hydra-etl-og.png', noindex = false, software = false, exactTitle, article, jsonld = [] } = Astro.props;
const site = Astro.site ?? new URL('https://hydraetl.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = exactTitle ?? `${title} — Hydra ETL`;
const githubUrl = 'https://github.com/bejaouibechir/Hydra';
const authorUrl = 'https://github.com/bejaouibechir';
const linkedinUrl = 'https://www.linkedin.com/in/bejaoui-bechir-06b2452b/';

/* Profils tiers qui decrivent le MEME logiciel. Portes a la fois par
   l'organisation et par SoftwareApplication : la collision de nom
   ("Hydra" de Meta, HydraETL en Haskell) se joue au niveau du produit,
   donc c'est le noeud produit qui doit etre reconcilie. */
const sameAs = [
  githubUrl,
  'https://pypi.org/project/hydra-etl/',
  'https://glama.ai/mcp/servers/bejaouibechir/Hydra',
  'https://sourceforge.net/projects/hydra-etl/',
  'https://alternativeto.net/software/hydra-etl/',
  'https://www.saashub.com/hydra-etl',
  'https://python.libhunt.com/bejaouibechir-hydra-alternatives',
  'https://dev.to/bejaouibechir',
];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${site.origin}/#organization`,
    name: 'Hydra ETL',
    url: `${site.origin}/`,
    logo: `${site.origin}/hydra-mark-512.png`,
    sameAs,
    founder: { '@id': `${site.origin}/#author` },
  },
  {
    '@type': 'Person',
    '@id': `${site.origin}/#author`,
    name: 'Bechir Bejaoui',
    url: authorUrl,
    sameAs: [authorUrl, linkedinUrl],
  },
  {
    '@type': 'WebSite',
    '@id': `${site.origin}/#website`,
    name: 'Hydra ETL',
    url: `${site.origin}/`,
    publisher: { '@id': `${site.origin}/#organization` },
  },
];
if (software) {
  graph.push({
    '@type': 'SoftwareApplication',
    '@id': `${site.origin}/#software`,
    name: 'Hydra ETL',
    alternateName: ['hydra-etl', 'Hydra ETL engine', 'hdrctl'],
    description: 'Open-source declarative ETL engine: YAML pipelines validated before they run, with a CLI, a REST API and a visual Studio.',
    /* Propriete schema.org prevue exactement pour ce cas : trois projets
       distincts partagent le nom "Hydra". Sans cette phrase, les moteurs et
       les LLM melangent les trois et citent PyPI ou GitHub a la place du site. */
    disambiguatingDescription: 'Hydra ETL is a Python ETL engine published on PyPI as hydra-etl and maintained by Bechir Bejaoui. It is a different project from Hydra (hydra-core), the Python configuration framework from Meta hosted at hydra.cc, and from HydraETL, a Haskell streaming library.',
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'ETL and data integration',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: 'Python',
    softwareVersion: version.version,
    softwareRequirements: 'Python 3.9 or later',
    url: `${site.origin}/`,
    downloadUrl: 'https://pypi.org/project/hydra-etl/',
    installUrl: `${site.origin}/install`,
    codeRepository: githubUrl,
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs,
    author: { '@id': `${site.origin}/#author` },
    maintainer: { '@id': `${site.origin}/#author` },
    publisher: { '@id': `${site.origin}/#organization` },
  });
}
if (article) {
  // Refletent exactement ce qui est affiche : titre, auteur et dates visibles
  // dans l'en-tete de l'article. Rien d'invente (pas de note, pas d'avis).
  graph.push({
    '@type': 'TechArticle',
    '@id': `${canonical}#article`,
    headline: article.headline,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified ?? article.datePublished,
    author: { '@type': 'Person', '@id': `${site.origin}/#author`, name: article.author, url: authorUrl, sameAs: [authorUrl, linkedinUrl] },
    publisher: { '@id': `${site.origin}/#organization` },
    mainEntityOfPage: canonical,
    image: ogImage,
    inLanguage: 'en',
  });
}
graph.push(...jsonld);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hydra ETL" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="32e25563-c8f5-439f-9503-324694899add" data-domains="hydraetl.com"></script>
    <link rel="icon" href="/hydra-mark-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/hydra-mark.png" sizes="96x96" type="image/png" />
    <link rel="alternate icon" href="/hydra.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/hydra-mark-192.png" />
    <script is:inline>
      // Applique le thème sauvegardé avant le rendu pour éviter le flash.
      (function () {
        try {
          var t = localStorage.getItem('hydra-theme');
          if (t) document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <style is:global set:html={mobileFixes}></style>
    <SiteSearch />
    <script is:inline set:html={sideToggleJs}></script>
  </body>
</html>
