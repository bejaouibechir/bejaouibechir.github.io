---
/*
  Châssis unique de la section /dsl.
  Le menu latéral n'existe qu'ici et vient de src/data/dsl-menu.json.
  Une page ne fournit que son contenu principal, via <slot />.
*/
import menu from '../data/dsl-menu.json';
import shellJs from '../scripts/dsl-shell.js?raw';

interface Props {
  current: string;
}
const { current } = Astro.props;

const visibleChapters = menu.chapters;
const chapterContainsCurrent = (ch: (typeof menu.chapters)[number]) =>
  ch.items.some((item) => item.key === current);
---

<header class="topbar">
  <a class="brand" href="/dsl">
    <img class="logo" src="/hydra-mark.png" width="22" height="22" alt="" decoding="async" />
    Hydra Guide
  </a>
  <nav class="nav" aria-label="Main navigation">
    <a href="/get-started">Get started</a><a href="/cli">Hydra CLI</a><a href="/studio">Hydra Studio</a><a href="/playground">Playground</a><a class="active" href="/dsl" aria-current="page">Hydra DSL</a><a href="/guide">Guide</a><a href="/migrate">Migrate</a><a href="/vscode">VS Code extension</a>
  </nav>
  <div class="spacer"></div>
  <button class="search" id="searchBtn" type="button" aria-label="Search the Hydra DSL">Search the DSL… <span class="key">Ctrl K</span></button>
  <button class="iconbtn burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">☰</button>
  <button class="iconbtn" id="themeBtn" type="button" aria-label="Toggle light or dark theme" title="Toggle theme">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</header>

<nav class="drawer" id="drawer" aria-label="Mobile navigation">
  <a href="/get-started">Get started</a><a href="/cli">Hydra CLI</a><a href="/studio">Hydra Studio</a><a href="/playground">Playground</a><a class="active" href="/dsl" aria-current="page">Hydra DSL</a><a href="/guide">Guide</a><a href="/migrate">Migrate</a><a href="/vscode">VS Code extension</a>
</nav>

<div class="shell">
  <aside class="side" aria-label="Hydra DSL">
    <div class="side-head">
      <strong>Hydra DSL</strong>
      <span>The grammar · {menu.total} elements</span>
    </div>
    <nav class="chapters" id="chapters" aria-label="Grammar">
      <ul class="ch-flat">
        {menu.links.map((l) => (
          <li>
            {l.key === current
              ? <a class="lsn on" href={l.href} aria-current="page">{l.label}</a>
              : <a class="lsn" href={l.href}>{l.label}</a>}
          </li>
        ))}
      </ul>

      {visibleChapters.map((ch) => {
        const isOpen = chapterContainsCurrent(ch);
        return (
          <section class={isOpen ? 'ch open' : 'ch'}>
            <button class={isOpen ? 'ch-head on' : 'ch-head'} type="button" aria-expanded={String(isOpen)} aria-controls={`ch${ch.num}`}>
              <span class="ch-num">{ch.num}</span><span class="ch-name">{ch.name}</span><span class="ch-meta">{ch.items.length}</span><span class="ch-caret" aria-hidden="true">›</span>
            </button>
            <ul class="ch-list" id={`ch${ch.num}`} hidden={!isOpen}>
              {ch.items.map((i) => (
                <li>
                  {i.key === current
                    ? <a class="lsn on" href={i.href} aria-current="page">{i.label}</a>
                    : i.href
                      ? <a class="lsn" href={i.href}>{i.label}</a>
                      : <span class="lsn soon">{i.label}<em>soon</em></span>}
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </nav>
    <div class="side-foot">
      <div class="row"><span>Grammar covered</span><b id="sidePercent">0%</b></div>
      <div class="meter"><i id="sideMeter"></i></div>
      <div class="row"><span>0 / {menu.total} elements</span><span>{menu.published} of {menu.total} published</span></div>
    </div>
  </aside>

  <main class="main">
    <slot />
  </main>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script is:inline set:html={shellJs}></script>
