---
/*
  Barre de navigation unique du site, rendue par BaseLayout sur toutes les pages.
  Elle remplace les 16 copies qui vivaient dans les pages, les shells et les
  maquettes (_mock/*.body.html).

  Compatibilite : les id historiques (themeBtn, burger, drawer, searchBtn) sont
  conserves pour que les scripts de page qui les cherchent ne plantent pas.
  Le comportement (theme, tiroir) est gere ICI, en phase de capture : les
  anciens gestionnaires de page ne recoivent plus le clic, donc pas de double
  bascule. Les classes sont prefixees `sh-` pour echapper aux CSS de page.
*/
import css from '../styles/site-header.css?raw';

const links = [
  { href: '/get-started', label: 'Get started', match: ['get-started', 'install', 'firstjob', 'build'] },
  { href: '/cli', label: 'Hydra CLI', match: ['cli'] },
  { href: '/studio', label: 'Hydra Studio', match: ['studio'] },
  { href: '/playground', label: 'Playground', match: ['playground'] },
  { href: '/dsl', label: 'Hydra DSL', match: ['dsl'] },
  { href: '/guide', label: 'Guide', match: ['guide'] },
  { href: '/migrate', label: 'Migrate', match: ['migrate'] },
  { href: '/vscode', label: 'VS Code extension', match: ['vscode'] },
];

const segment = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const isActive = (l: (typeof links)[number]) => l.match.includes(segment);
const isExact = (href: string) => Astro.url.pathname.replace(/\/$/, '') === href;
---

<style is:global set:html={css}></style>

<header class="sh-top">
  <a class="sh-brand" href="/" aria-label="Hydra ETL home">
    <img src="/hydra-mark.png" width="22" height="22" alt="" decoding="async" />
    <span>Hydra ETL</span>
  </a>

  <nav class="sh-nav" aria-label="Main navigation">
    {links.map((l) => (
      <a class:list={{ 'sh-on': isActive(l) }} href={l.href} aria-current={isExact(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <div class="sh-tools">
    <button class="sh-search" id="searchBtn" type="button" data-site-search aria-label="Search the site">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span class="sh-search-label">Search</span>
      <kbd class="sh-kbd">Ctrl K</kbd>
    </button>
    <a class="sh-cta" data-umami-event="first-job-click" data-umami-event-location="header" href="/firstjob">Build your first job</a>
    <button class="sh-icon sh-burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="sh-icon" data-umami-event="github-click" data-umami-event-location="header" href="https://github.com/bejaouibechir/Hydra" target="_blank" rel="noopener" aria-label="Hydra on GitHub" title="Hydra on GitHub">
      <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
    <button class="sh-icon" id="themeBtn" type="button" aria-label="Toggle light or dark theme" title="Toggle theme">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>

<nav class="sh-drawer" id="drawer" aria-label="Mobile navigation">
  {links.map((l) => (
    <a class:list={{ 'sh-on': isActive(l) }} href={l.href} aria-current={isExact(l.href) ? 'page' : undefined}>{l.label}</a>
  ))}
  <a data-umami-event="github-click" data-umami-event-location="drawer" href="https://github.com/bejaouibechir/Hydra" target="_blank" rel="noopener">GitHub</a>
  <a class="sh-cta" data-umami-event="first-job-click" data-umami-event-location="header" href="/firstjob">Build your first job</a>
</nav>

<script is:inline>
  (function () {
    var burger = document.getElementById('burger');
    var drawer = document.getElementById('drawer');

    if (/Mac|iPhone|iPad/.test(navigator.platform || '')) {
      document.querySelectorAll('.sh-kbd').forEach(function (k) { k.textContent = '⌘K'; });
    }

    function setDrawer(open) {
      drawer.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    function toggleTheme() {
      var root = document.documentElement;
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('hydra-theme', next); } catch (e) { /* stockage indisponible */ }
      document.dispatchEvent(new CustomEvent('hydra:theme', { detail: next }));
    }

    /* Capture sur document : s'execute avant les anciens gestionnaires de page
       et les empeche de rebasculer. */
    document.addEventListener('click', function (e) {
      var t = e.target instanceof Element ? e.target : null;
      if (!t) return;
      if (t.closest('#themeBtn')) {
        e.stopPropagation();
        toggleTheme();
        return;
      }
      if (t.closest('#burger')) {
        e.stopPropagation();
        setDrawer(!drawer.classList.contains('open'));
        return;
      }
      if (drawer.classList.contains('open') && !drawer.contains(t)) setDrawer(false);
    }, true);

    drawer.addEventListener('click', function (e) {
      if (e.target instanceof Element && e.target.closest('a')) setDrawer(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        setDrawer(false);
        burger.focus();
      }
    });
  })();
</script>
