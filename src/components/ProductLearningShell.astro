---
interface Module { title: string; description: string }
/* Un atelier porte deux intitules : `label`, court, pour le menu de gauche ;
   `title`, complet, pour la carte de droite. */
/* `slug` : la route servie sous /cli/ ou /studio/. Absent tant que la lecon n'est pas ecrite. */
interface Lesson { label: string; title: string; description: string; command?: string; group?: string; slug?: string | null }
interface Props {
  product: 'CLI' | 'Studio';
  title: string;
  lead: string;
  duration: string;
  modules?: Module[];
  lessons?: Lesson[];
  referenceHref: string;
  referenceLabel: string;
  /* Renseigne sur une page de lecon : le sommaire allume l'entree correspondante
     et le panneau de droite affiche le contenu passe en slot, pas la carte du cours. */
  activeSlug?: string | null;
}
const {
  product, title, lead, duration,
  modules = [], lessons = [],
  referenceHref, referenceLabel,
  activeSlug = null,
} = Astro.props;

const useLessons = lessons.length > 0;
const unitCount = useLessons ? lessons.length : modules.length;
const unitWord = useLessons ? 'lessons' : 'modules';
const num = (i: number) => String(i + 1).padStart(2, '0');
const trackHref = product === 'CLI' ? '/cli' : '/studio';
const isLessonPage = activeSlug !== null && activeSlug !== undefined;
const activeIndex = lessons.findIndex((l) => l.slug === activeSlug);
const currentLabel = isLessonPage && activeIndex >= 0
  ? `${String(activeIndex + 1).padStart(2, '0')} · ${lessons[activeIndex].label}`
  : 'Tutorials overview';

/* Une lecon ecrite se rejoint par sa route. Une lecon non ecrite reste une ancre
   vers sa carte sur la page d'ensemble : jamais de lien mort, jamais de silence. */
const lessonHref = (lesson: Lesson, index: number) =>
  lesson.slug ? `${trackHref}/${lesson.slug}`
              : isLessonPage ? `${trackHref}#lesson-${num(index)}`
                             : `#lesson-${num(index)}`;
---

<div class="learn-shell">
  <aside class="course-side" aria-label={`${product} tutorial outline`}>
    <button class="side-toggle" type="button" aria-expanded="false" aria-controls="courseOutline" data-side-toggle>
      <span>Lessons</span><b>{currentLabel}</b><i aria-hidden="true">▾</i>
    </button>
    <a class="all-tracks" href="/get-started"><span aria-hidden="true">←</span><b>All learning tracks</b><small>return to Get started</small></a>
    <div class="track-name"><span>{product}</span><b>{title}</b><small>{unitCount} {unitWord} · {duration}</small></div>
    <nav class="course-outline" aria-label={useLessons ? 'Course lessons' : 'Course modules'} id="courseOutline">
      <a class:list={['overview-link', { current: !isLessonPage }]} href={trackHref} aria-current={isLessonPage ? undefined : 'page'}><span>—</span><b>Tutorials overview</b></a>
      {useLessons
        ? lessons.map((lesson, index) => (
            <a
              class:list={['outline-item', { on: isLessonPage && lesson.slug === activeSlug, written: !!lesson.slug }]}
              href={lessonHref(lesson, index)}
              data-lesson={isLessonPage ? undefined : `lesson-${num(index)}`}
              aria-current={isLessonPage && lesson.slug === activeSlug ? 'page' : undefined}
            >
              <span>{num(index)}</span><b>{lesson.label}</b>
              {!lesson.slug && <small>outline</small>}
            </a>
          ))
        : modules.map((module, index) => (
            <div class="outline-item"><span>{num(index)}</span><b>{module.title}</b><small>outline</small></div>
          ))}
    </nav>
  </aside>

  <main class="learn-main">
    {isLessonPage ? <slot /> : (
    <Fragment>
    <div class="crumbs"><a href="/get-started">Get started</a><span>›</span><span>Hydra {product}</span></div>

    <section class="track-hero">
      <div>
        <div class="eyebrow"><span></span>Hydra {product} learning track</div>
        <h1>{title}</h1>
        <p>{lead}</p>
        <div class="hero-meta"><span>{unitCount} {unitWord}</span><span>{duration}</span><span>beginner to independent</span></div>
      </div>
    </section>

    <section class="course-map" aria-labelledby="courseMapTitle">
      <div class="section-head"><div><span>Course map</span><h2 id="courseMapTitle">All {unitWord}</h2></div><p>Follow them in order, or jump to the one you need.</p></div>
      {useLessons ? (
        <div class="lesson-grid">{lessons.map((lesson, index) => (
          lesson.slug ? (
            <a id={`lesson-${num(index)}`} class="lesson-card open" href={`${trackHref}/${lesson.slug}`}>
              <span class="module-num">{num(index)}</span>
              <div>
                {lesson.group && <span class="lesson-group">{lesson.group}</span>}
                <h3>{lesson.title}</h3>
                <p>{lesson.description}</p>
                {lesson.command && <code class="lesson-cmd">{lesson.command}</code>}
              </div>
              <small class="lesson-go">Start <span aria-hidden="true">→</span></small>
            </a>
          ) : (
            <article id={`lesson-${num(index)}`} class="lesson-card">
              <span class="module-num">{num(index)}</span>
              <div>
                {lesson.group && <span class="lesson-group">{lesson.group}</span>}
                <h3>{lesson.title}</h3>
                <p>{lesson.description}</p>
                {lesson.command && <code class="lesson-cmd">{lesson.command}</code>}
              </div>
              <small>Outline</small>
            </article>
          )
        ))}</div>
      ) : (
        <div class="module-grid">{modules.map((module, index) => <article><span class="module-num">{num(index)}</span><div><h3>{module.title}</h3><p>{module.description}</p></div><small>Outline</small></article>)}</div>
      )}
    </section>


    <div class="track-actions"><a href={referenceHref}>{referenceLabel} <span aria-hidden="true">→</span></a><a href={product === 'CLI' ? '/studio' : '/cli'}>Switch to Hydra {product === 'CLI' ? 'Studio' : 'CLI'}</a></div>
    </Fragment>
    )}
  </main>
</div>

