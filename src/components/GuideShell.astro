---
/*
  Châssis de la section /guide.

  Le menu latéral d'un atelier n'est pas un arbre de chapitres : un lecteur qui suit une
  procédure veut revenir au Guide, et sauter sur les sujets voisins déjà écrits. Il porte
  donc un retour, puis des liens réellement publiés — jamais de « soon ».

  Les liens voisins sont passés par la page via la propriété `related`.
*/
import shellJs from '../scripts/dsl-shell.js?raw';
import { guideTutorials } from '../data/guide-tutorials.js';

interface Related { label: string; href: string; note?: string }
interface Props {
  current?: string;
  related?: Related[];
}
const { related = [] } = Astro.props;
const searchItems = [
  { label: 'Read a CSV file', href: '/guide/sources/csv' },
  ...guideTutorials.map((tutorial) => ({ label: tutorial.title, href: tutorial.route }))
];
---

<div class="shell">
  <aside class="side" aria-label="Workshop navigation">
    <a class="backlink" href="/guide">
      <span class="backarrow" aria-hidden="true">←</span>
      <span class="backcopy"><b>All guides</b><small>browse the catalogue</small></span>
    </a>

    {related.length > 0 && (
      <nav class="related" aria-label="Related topics">
        <div class="side-title">Related, and ready</div>
        <ul>
          {related.map((r) => (
            <li>
              <a href={r.href}>
                <b>{r.label}</b>
                {r.note && <small>{r.note}</small>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </aside>

  <main class="main">
    <slot />
  </main>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script is:inline set:html={shellJs}></script>
