---
/*
  Châssis de la section /guide.

  Le menu latéral d'un atelier n'est pas un arbre de chapitres : un lecteur qui suit une
  procédure veut revenir au Guide, et sauter sur les sujets voisins déjà écrits. Il porte
  donc un retour, puis des liens réellement publiés — jamais de « soon ».

  Les liens voisins sont passés par la page via la propriété `related`.
*/
import shellJs from '../scripts/dsl-shell.js?raw';
import { guideTutorials } from '../data/guide-tutorials.js';

interface Related { label: string; href: string; note?: string }
interface Props {
  current?: string;
  related?: Related[];
}
const { related = [] } = Astro.props;
const searchItems = [
  { label: 'Read a CSV file', href: '/guide/sources/csv' },
  ...guideTutorials.map((tutorial) => ({ label: tutorial.title, href: tutorial.route }))
];
---

<header class="topbar">
  <a class="brand" href="/guide">
    <img class="logo" src="/hydra-mark.png" width="22" height="22" alt="" decoding="async" />
    Hydra Guide
  </a>
  <nav class="nav" aria-label="Main navigation">
    <a href="/get-started">Get started</a><a href="/cli">Hydra CLI</a><a href="/studio">Hydra Studio</a><a href="/playground">Playground</a><a href="/dsl">Hydra DSL</a><a class="active" href="/guide" aria-current="page">Guide</a><a href="/migrate">Migrate</a><a href="/vscode">VS Code extension</a>
  </nav>
  <div class="spacer"></div>
  <button class="search" id="searchBtn" type="button" aria-label="Search the Hydra Guide">Search the guide… <span class="key">Ctrl K</span></button>
  <button class="iconbtn burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">☰</button>
  <button class="iconbtn" id="themeBtn" type="button" aria-label="Toggle light or dark theme" title="Toggle theme">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</header>

<nav class="drawer" id="drawer" aria-label="Mobile navigation">
  <a href="/get-started">Get started</a><a href="/cli">Hydra CLI</a><a href="/studio">Hydra Studio</a><a href="/playground">Playground</a><a href="/dsl">Hydra DSL</a><a class="active" href="/guide" aria-current="page">Guide</a><a href="/migrate">Migrate</a><a href="/vscode">VS Code extension</a>
</nav>

<div class="shell">
  <aside class="side" aria-label="Workshop navigation">
    <a class="backlink" href="/guide">
      <span class="backarrow" aria-hidden="true">←</span>
      <span class="backcopy"><b>All guides</b><small>browse the catalogue</small></span>
    </a>

    {related.length > 0 && (
      <nav class="related" aria-label="Related topics">
        <div class="side-title">Related, and ready</div>
        <ul>
          {related.map((r) => (
            <li>
              <a href={r.href}>
                <b>{r.label}</b>
                {r.note && <small>{r.note}</small>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </aside>

  <main class="main">
    <slot />
  </main>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script is:inline set:html={shellJs}></script>
