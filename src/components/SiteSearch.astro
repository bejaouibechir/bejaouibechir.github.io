---
/*
  Recherche plein texte du site, montee une fois par page depuis BaseLayout.
  L'index est servi par /search-index.json et charge a la premiere ouverture.
*/
import css from '../styles/site-search.css?raw';
import js from '../scripts/site-search.js?raw';
---

<style is:global set:html={css}></style>

<div class="hs-overlay" id="hsOverlay" role="dialog" aria-modal="true" aria-label="Search this site">
  <div class="hs-panel">
    <div class="hs-field">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="hsInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search every page…" aria-label="Search every page" />
      <span class="hs-esc">Esc</span>
    </div>
    <ul class="hs-results" id="hsResults" role="listbox" aria-label="Search results"></ul>
    <div class="hs-foot">
      <span><b>↑ ↓</b> navigate</span><span><b>↵</b> open</span><span id="hsCount"></span>
    </div>
  </div>
</div>

<div class="hs-bar" id="hsBar" role="status">
  <button id="hsPrev" type="button" aria-label="Previous match">‹</button>
  <b id="hsBarCount">0 / 0</b>
  <span>on this page</span>
  <button id="hsNext" type="button" aria-label="Next match">›</button>
  <button id="hsClear" type="button" aria-label="Clear highlight">✕</button>
</div>

<script is:inline set:html={js}></script>
